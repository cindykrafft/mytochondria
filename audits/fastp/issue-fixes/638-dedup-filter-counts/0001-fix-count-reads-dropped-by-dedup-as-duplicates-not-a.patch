     ofs << padding << "\t" << "\"too_short_reads\": " << mFilterReadStats[FAIL_LENGTH] << "," << endl;
@@ -372,6 +377,8 @@ void FilterResult::reportHtml(ofstream& ofs, long totalReads, long totalBases) {
