-		resultList.clearAll();
-		_overlapBases.clear();
-	}	
-	// was there sufficient overlap with respect ot -b when using -r? if not, delete.
-	if (_hasReciprocal &&
-				((float)totalUniqueOverlap / (float)hitBlockSumLength < _overlapFractionA)) 
-	{
-		resultList.clearAll();
-		_overlapBases.clear();
-	}
 
 	// clean up
 	if (deleteKeyBlocks) {
