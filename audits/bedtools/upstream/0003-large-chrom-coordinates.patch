+"chr1	3000000000	3000000010
+chr1	3000000020	3000000100" > exp
+$BT subtract -a biga.bed -b bigb.bed > obs
+check obs exp
+rm obs exp biga.bed bigb.bed
+
+
 [[ $FAILURES -eq 0 ]] || exit 1;
