diff --git a/test/flank/test-flank.sh b/test/flank/test-flank.sh
index b610b24..7b08f55 100644
--- a/test/flank/test-flank.sh
+++ b/test/flank/test-flank.sh
@@ -151,4 +151,18 @@ chr1	200	1000	a2	2	-" > exp
 $BT flank -i a.bed -b 2000 -s -g tiny.genome > obs
 check obs exp
 rm obs exp
+###########################################################
+#  flank on a large chromosome (coordinates > 2^31)
+###########################################################
+echo -e "    flank.t_bigchrom...\c"
+echo -e "chr1\t5000000000" > big.genome
+echo -e "chr1\t3000000000\t3000000100\tf1\t1\t+" > big.bed
+echo \
+"chr1	2999999990	3000000000	f1	1	+
+chr1	3000000100	3000000110	f1	1	+" > exp
+$BT flank -i big.bed -g big.genome -l 10 -r 10 > obs
+check obs exp
+rm obs exp big.bed big.genome
+
+
 [[ $FAILURES -eq 0 ]] || exit 1;
diff --git a/test/reldist/test-reldist.sh b/test/reldist/test-reldist.sh
index 589cafe..f2e12f2 100644
--- a/test/reldist/test-reldist.sh
+++ b/test/reldist/test-reldist.sh
@@ -166,4 +166,21 @@ $BT reldist -a issue_711.a.bed \
 check obs exp
 rm obs exp
 
+###########################################################
+#  reldist on a large chromosome (coordinates > 2^31):
+#  B midpoints at 3e9 and 3e9+1000, A midpoint at 3e9+100
+#  -> relative distance 0.100.
+###########################################################
+echo -e "    reldist.t_bigchrom...\c"
+echo \
+"chr1	2999999900	3000000100
+chr1	3000000900	3000001100" > bigb.bed
+echo -e "chr1\t3000000050\t3000000150" > biga.bed
+echo \
+"chr1	3000000050	3000000150	0.100" > exp
+$BT reldist -a biga.bed -b bigb.bed -detail > obs
+check obs exp
+rm obs exp biga.bed bigb.bed
+
+
 [[ $FAILURES -eq 0 ]] || exit 1;
