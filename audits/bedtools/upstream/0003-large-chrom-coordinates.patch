         {
             right.start    = feature.end;
             right.end     += (rightFlank);
@@ -128,10 +128,10 @@ void BedFlank::AddFlank(BED &bed, int leftFlank, int rightFlank) {
 }
 
 
-void BedFlank::AddStrandedFlank(BED &bed, int leftFlank, int rightFlank) {
