From cec77cfe06479bda3740c9b040d3afababc19315 Mon Sep 17 00:00:00 2001
From: Cindy Krafft <cynthiacondra@gmail.com>
Date: Fri, 25 Sep 2026 05:38:18 +0000
Subject: [PATCH] FIX GaussianNB.partial_fit: keep the smoothing consistent
 across chunks

_partial_fit overwrote self.epsilon_ with the new chunk's value before
subtracting it from var_, so the smoothing added by the previous call
was removed with a different value (var_ off by 2 % at
var_smoothing=0.1 on two chunks, 5e-8 relative at the default), and
epsilon_ after the last call reflected the last chunk only. Compute
epsilon_ from the variance of each feature over all the data seen so far
(law of total variance on the per-class statistics), so that partial_fit
matches fit exactly for any chunking, with or without sample_weight.
Adds a regression test and a changelog entry.
---
 .../sklearn.naive_bayes/XXXXX.fix.rst         |  6 +++++
 sklearn/naive_bayes.py                        | 22 ++++++++++++-----
 sklearn/tests/test_naive_bayes.py             | 24 +++++++++++++++++++
 3 files changed, 46 insertions(+), 6 deletions(-)
 create mode 100644 doc/whats_new/upcoming_changes/sklearn.naive_bayes/XXXXX.fix.rst

diff --git a/doc/whats_new/upcoming_changes/sklearn.naive_bayes/XXXXX.fix.rst b/doc/whats_new/upcoming_changes/sklearn.naive_bayes/XXXXX.fix.rst
new file mode 100644
index 0000000000..6034aff2b7
--- /dev/null
+++ b/doc/whats_new/upcoming_changes/sklearn.naive_bayes/XXXXX.fix.rst
@@ -0,0 +1,6 @@
+- :meth:`naive_bayes.GaussianNB.partial_fit` now gives the same `var_` and
+  `epsilon_` as :meth:`naive_bayes.GaussianNB.fit` on the same data whatever
+  the chunking: the smoothing added by the previous call was removed with the
+  new chunk's `epsilon_`, and `epsilon_` was computed from the last chunk
+  alone instead of from all the data seen so far.
+  By :user:`Cindy Krafft <cindykrafft>`.
diff --git a/sklearn/naive_bayes.py b/sklearn/naive_bayes.py
index efe13d2a81..73733a9ca0 100644
--- a/sklearn/naive_bayes.py
+++ b/sklearn/naive_bayes.py
@@ -443,11 +443,6 @@ class GaussianNB(_BaseNB):
             sample_weight = _check_sample_weight(sample_weight, X, dtype=float_dtype)
 
         xp_y, _ = get_namespace(y)
-        # If the ratio of data variance between dimensions is too small, it
-        # will cause numerical errors. To address this, we artificially
-        # boost the variance by epsilon, a small fraction of the standard
-        # deviation of the largest dimension.
-        self.epsilon_ = self.var_smoothing * xp.max(xp.var(X, axis=0))
 
         if first_call:
             # This is the first call to partial_fit:
@@ -486,7 +481,9 @@ class GaussianNB(_BaseNB):
             if X.shape[1] != self.theta_.shape[1]:
                 msg = "Number of features %d does not match previous data %d."
                 raise ValueError(msg % (X.shape[1], self.theta_.shape[1]))
-            # Put epsilon back in each time
+            # Remove the smoothing added at the end of the previous call, with
+            # the value that was added then (self.epsilon_ is recomputed below
+            # from the statistics of all the data seen so far).
             self.var_[:, :] -= self.epsilon_
 
         classes = self.classes_
@@ -520,6 +517,19 @@ class GaussianNB(_BaseNB):
             self.var_[i, :] = new_sigma
             self.class_count_[i] += N_i
 
+        # If the ratio of data variance between dimensions is too small, it
+        # will cause numerical errors. To address this, we artificially
+        # boost the variance by epsilon, a small fraction of the standard
+        # deviation of the largest dimension. The variance of each feature over
+        # all the data seen so far follows from the per-class means, variances
+        # and counts (law of total variance), so that partial_fit gives the
+        # same epsilon_ as fit on the same data regardless of the chunking.
+        total_count = xp.sum(self.class_count_)
+        overall_mean = (self.class_count_ @ self.theta_) / total_count
+        overall_var = (
+            self.class_count_ @ (self.var_ + (self.theta_ - overall_mean) ** 2)
+        ) / total_count
+        self.epsilon_ = self.var_smoothing * xp.max(overall_var)
         self.var_[:, :] += self.epsilon_
 
         # Update if only no priors is provided
diff --git a/sklearn/tests/test_naive_bayes.py b/sklearn/tests/test_naive_bayes.py
index 7e30730bcd..4c3815b0fb 100644
--- a/sklearn/tests/test_naive_bayes.py
+++ b/sklearn/tests/test_naive_bayes.py
@@ -1049,3 +1049,27 @@ def test_gnb_array_api_compliance(
         assert_allclose(
             move_to(y_pred_log_proba_xp, xp=np, device="cpu"), y_pred_log_proba_np
         )
+
+
+@pytest.mark.parametrize("var_smoothing", [1e-9, 0.1, 0.5])
+def test_gnb_partial_fit_epsilon(global_random_seed, var_smoothing):
+    # partial_fit over chunks must give the same variances and smoothing as
+    # fit on all the data: epsilon_ is var_smoothing times the largest
+    # feature variance of all the data seen so far, and the smoothing added by
+    # the previous call is removed with the value that was added.
+    rng = np.random.RandomState(global_random_seed)
+    X = rng.standard_normal((200, 3)) * [1.0, 5.0, 0.1] + 3.0
+    y = rng.randint(0, 2, 200)
+    sample_weight = rng.uniform(0.5, 2.0, 200)
+
+    clf_fit = GaussianNB(var_smoothing=var_smoothing).fit(X, y, sample_weight)
+    clf_pf = GaussianNB(var_smoothing=var_smoothing)
+    for chunk in (slice(0, 30), slice(30, 150), slice(150, 200)):
+        clf_pf.partial_fit(
+            X[chunk], y[chunk], classes=[0, 1], sample_weight=sample_weight[chunk]
+        )
+
+    assert_allclose(clf_pf.epsilon_, clf_fit.epsilon_)
+    assert_allclose(clf_pf.var_, clf_fit.var_)
+    assert_allclose(clf_pf.theta_, clf_fit.theta_)
+    assert_allclose(clf_pf.predict_proba(X), clf_fit.predict_proba(X))
-- 
