From b914d904d6aa81eb516daa7ea9585be3260c1e69 Mon Sep 17 00:00:00 2001
From: Cindy Krafft <cynthiacondra@gmail.com>
Date: Fri, 25 Sep 2026 05:53:52 +0000
Subject: [PATCH] FIX IsotonicRegression: honour out_of_bounds with a single
 distinct X

_build_f short-circuited the single-y case to a constant function, so
out_of_bounds="nan" returned the constant outside the (degenerate)
training domain and out_of_bounds="raise" never raised, unlike the
interp1d path used for two or more distinct X. Adds a regression test
and a changelog entry.
---
 .../sklearn.isotonic/XXXXX.fix.rst            |  5 +++++
 sklearn/isotonic.py                           | 20 +++++++++++++++++--
 sklearn/tests/test_isotonic.py                | 15 ++++++++++++++
 3 files changed, 38 insertions(+), 2 deletions(-)
 create mode 100644 doc/whats_new/upcoming_changes/sklearn.isotonic/XXXXX.fix.rst

diff --git a/doc/whats_new/upcoming_changes/sklearn.isotonic/XXXXX.fix.rst b/doc/whats_new/upcoming_changes/sklearn.isotonic/XXXXX.fix.rst
new file mode 100644
index 0000000000..ec02a2c48e
--- /dev/null
+++ b/doc/whats_new/upcoming_changes/sklearn.isotonic/XXXXX.fix.rst
@@ -0,0 +1,5 @@
+- :class:`isotonic.IsotonicRegression` fitted on a single distinct `X` value now
+  honours `out_of_bounds` for predictions elsewhere ("nan" gives NaN and
+  "raise" raises, as for a wider training domain) instead of returning the
+  constant everywhere.
+  By :user:`Cindy Krafft <cindykrafft>`.
diff --git a/sklearn/isotonic.py b/sklearn/isotonic.py
index ee73ac2c0f..633513e5fc 100644
--- a/sklearn/isotonic.py
+++ b/sklearn/isotonic.py
@@ -302,8 +302,24 @@ class IsotonicRegression(RegressorMixin, TransformerMixin, BaseEstimator):
 
         bounds_error = self.out_of_bounds == "raise"
         if len(y) == 1:
-            # single y, constant prediction
-            self.f_ = lambda x: y.repeat(x.shape)
+            # single distinct X: constant prediction inside the (degenerate)
+            # training domain, out_of_bounds handled as interp1d does
+            x_train = X[0]
+
+            def f_(x):
+                x = np.asarray(x)
+                res = y.repeat(x.shape)
+                outside = x != x_train
+                if self.out_of_bounds != "clip" and np.any(outside):
+                    if bounds_error:
+                        raise ValueError(
+                            "A value in x_new is outside the interpolation range."
+                        )
+                    res = res.astype(np.float64)
+                    res[outside] = np.nan
+                return res
+
+            self.f_ = f_
         else:
             self.f_ = interpolate.interp1d(
                 X, y, kind="linear", bounds_error=bounds_error
diff --git a/sklearn/tests/test_isotonic.py b/sklearn/tests/test_isotonic.py
index 6b151b7e25..b4415cdf3e 100644
--- a/sklearn/tests/test_isotonic.py
+++ b/sklearn/tests/test_isotonic.py
@@ -697,3 +697,18 @@ def test_isotonic_regression_output_predict():
 
     assert isinstance(X_trans, pd.DataFrame)
     assert isinstance(y_pred, np.ndarray)
+
+
+@pytest.mark.parametrize("out_of_bounds", ["nan", "clip", "raise"])
+def test_isotonic_regression_single_distinct_x_oob(out_of_bounds):
+    # With a single distinct X the training domain is one point; predictions
+    # elsewhere follow out_of_bounds like they do for a wider domain.
+    ir = IsotonicRegression(out_of_bounds=out_of_bounds).fit([2, 2, 2], [1, 3, 5])
+    assert_array_equal(ir.predict([2]), [3])
+    if out_of_bounds == "clip":
+        assert_array_equal(ir.predict([1, 2, 4]), [3, 3, 3])
+    elif out_of_bounds == "nan":
+        assert_array_equal(ir.predict([1, 2, 4]), [np.nan, 3, np.nan])
+    else:
+        with pytest.raises(ValueError, match="outside the interpolation range"):
+            ir.predict([1, 2, 4])
