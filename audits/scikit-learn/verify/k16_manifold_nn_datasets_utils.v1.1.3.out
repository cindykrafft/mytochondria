== utils.validation.check_array
ok   check_array(float32, dtype='numeric') preserves float32; int64 preserved
ok   check_array(object array of numbers, dtype='numeric') -> float64 ('dtype is preserved unless array.dtype is object')
ok   check_array(int, dtype=[float64, float32]) -> first listed type; float32 kept
ok   check_array: NaN / inf raise ValueError by default (force_all_finite=True)
ok   check_array(force_all_finite='allow-nan'): NaN passes, inf still raises
ok   check_array(force_all_finite=False): NaN and inf pass
ok   check_array(1-D) raises ValueError ('Expected 2D array'); ensure_2d=False passes
ok   check_array(3-D) raises unless allow_nd=True
ok   check_array(0 samples) raises ValueError (ensure_min_samples=1); 0 features raises (ensure_min_features=1)
ok   check_array(complex) raises ValueError ('Complex data not supported')
ok   check_array(sparse, accept_sparse=False) raises TypeError; accept_sparse='csr' converts csc -> csr
ok   check_array(order='F') returns Fortran-contiguous; copy=True returns a new buffer
ok   check_array(list of lists) -> float64 ndarray
