== B. CLI: (n+1) x 20 reads = adapter with one inserted base at p=0..n, plus 30 random nt
   adapter AGATCGGAAGAGCACACGTCTGAACTCCAGTCAC (34 nt), -e 0.1:
      -g ^AD (anchored 5')      : 700/700 reads trimmed
      -g AD  (regular 5')       : 700/700 reads trimmed
      -g XAD (non-internal 5')  : 700/700 reads trimmed
      -a AD$ (anchored 3')      : 700/700 reads trimmed
      -a AD  (regular 3')       : 700/700 reads trimmed
   adapter AGATCGGAAGAGCACACGTCTGAACTCCAGTCAC (34 nt), -e 1:
      -g ^AD (anchored 5')      : 392/700 reads trimmed
      -g AD  (regular 5')       : 700/700 reads trimmed
      -g XAD (non-internal 5')  : 398/700 reads trimmed
      -a AD$ (anchored 3')      : 388/700 reads trimmed
      -a AD  (regular 3')       : 700/700 reads trimmed
   adapter CTGTCTCTTATACACATCT (19 nt), -e 0.1:
      -g ^AD (anchored 5')      : 257/400 reads trimmed
      -g AD  (regular 5')       : 400/400 reads trimmed
      -g XAD (non-internal 5')  : 332/400 reads trimmed
      -a AD$ (anchored 3')      : 253/400 reads trimmed
      -a AD  (regular 3')       : 400/400 reads trimmed

