--- a/tests/test_adapters.py
+++ b/tests/test_adapters.py
@@ -15,6 +15,7 @@ from cutadapt.adapters import (
     IndexedPrefixAdapters,
     IndexedSuffixAdapters,
     NonInternalFrontAdapter,
+    NonInternalBackAdapter,
 )
 
 
@@ -703,3 +704,37 @@ def test_very_long_adapter_issue_749():
     assert match.astart == 0
     assert match.astop == 20
     assert match.errors == 0
+
+
+@pytest.mark.parametrize("insertion_position", [3, 15])
+def test_anchored_adapters_with_insertion_in_read(insertion_position):
+    # One inserted base makes the occurrence one base longer than the adapter.
+    # max_errors=0.1 on 19 nt allows one error, so the k-mer prefilter searches
+    # two chunks; the chunk on the far side of the insertion is shifted by one.
+    sequence = "CTGTCTCTTATACACATCT"
+    occurrence = sequence[:insertion_position] + "G" + sequence[insertion_position:]
+
+    prefix_adapter = PrefixAdapter(sequence, max_errors=0.1, indels=True)
+    match = prefix_adapter.match_to(occurrence + "AAAAAAAA")
+    assert match is not None
+    assert match.errors == 1
+    assert (match.rstart, match.rstop) == (0, 20)
+
+    suffix_adapter = SuffixAdapter(sequence, max_errors=0.1, indels=True)
+    match = suffix_adapter.match_to("AAAAAAAA" + occurrence)
+    assert match is not None
+    assert match.errors == 1
+    assert (match.rstart, match.rstop) == (8, 28)
+
+
+def test_noninternal_adapters_with_insertion_in_read():
+    sequence = "CTGTCTCTTATACACATCT"
+    occurrence = sequence[:10] + "G" + sequence[10:]
+    front_adapter = NonInternalFrontAdapter(sequence, max_errors=0.1, indels=True)
+    match = front_adapter.match_to(occurrence + "AAAAAAAA")
+    assert match is not None
+    assert match.errors == 1
+    back_adapter = NonInternalBackAdapter(sequence, max_errors=0.1, indels=True)
+    match = back_adapter.match_to("AAAAAAAA" + sequence[:8] + "G" + sequence[8:])
+    assert match is not None
+    assert match.errors == 1
