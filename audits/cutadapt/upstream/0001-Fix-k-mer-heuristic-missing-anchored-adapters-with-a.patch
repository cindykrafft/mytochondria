diff --git a/CHANGES.rst b/CHANGES.rst
index 9d3149f..008de83 100644
--- a/CHANGES.rst
+++ b/CHANGES.rst
@@ -2,6 +2,16 @@
 Changelog
 =========
 
+development version
+-------------------
+
+* Fixed: Anchored (``^ADAPTER``, ``ADAPTER$``) and non-internal
+  (``XADAPTER``, ``ADAPTERX``) adapters were sometimes not found when the read
+  contains the adapter with an inserted base, although the number of errors was
+  within the allowed limit. This happened when exactly one error was allowed
+  (for example, adapters of 10 to 19 nt at the default ``-e 0.1``, or
+  ``-e 1``), since the runtime heuristic was introduced in version 4.3.
+
 v5.2 (2025-10-23)
 -----------------
 
diff --git a/src/cutadapt/kmer_heuristic.py b/src/cutadapt/kmer_heuristic.py
index b25b189..3bfeb8e 100644
--- a/src/cutadapt/kmer_heuristic.py
+++ b/src/cutadapt/kmer_heuristic.py
@@ -112,7 +112,10 @@ def create_back_overlap_searchsets(
                     search_sets.append(search_set)
                 minimum_length = min_overlap_kmer_length
         kmer_sets = kmer_chunks(adapter[:minimum_length], max_errors + 1)
-        search_sets.append((-length, None, kmer_sets))
+        # An occurrence of the adapter prefix that contains insertions spans up
+        # to max_errors more positions in the read than in the adapter, so the
+        # search window needs to be that much longer than the prefix.
+        search_sets.append((-(length + max_errors), None, kmer_sets))
         minimum_length = length + 1
     return search_sets
 
