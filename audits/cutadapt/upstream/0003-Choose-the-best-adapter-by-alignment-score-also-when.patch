+    @staticmethod
+    def _alignment_score(
+        adapter_length: int, string_length: int, errors: int, matches: int
+    ) -> int:
+        """
+        Return the score (match: +1, mismatch: -1, indel: -2) of the alignment
+        between an adapter and a string from its edit environment. The numbers of
+        insertions, deletions and mismatches follow from the two lengths, the
+        number of errors and the number of matches.
+        """
+        insertions = matches - adapter_length + errors
+        deletions = matches - string_length + errors
+        mismatches = errors - insertions - deletions
+        return matches - mismatches - 2 * (insertions + deletions)
+
