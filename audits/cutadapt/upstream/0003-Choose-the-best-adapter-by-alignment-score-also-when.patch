diff --git a/tests/test_adapters.py b/tests/test_adapters.py
index f24ecdf..838bf65 100644
--- a/tests/test_adapters.py
+++ b/tests/test_adapters.py
@@ -703,3 +703,35 @@ def test_very_long_adapter_issue_749():
     assert match.astart == 0
     assert match.astop == 20
     assert match.errors == 0
+
+
+def test_indexed_prefix_adapters_use_alignment_score():
+    # The 11 nt adapter matches exactly (score 11); the 12 nt adapter matches
+    # with one inserted base (12 matches, but score 12 - 2 = 10). The index
+    # must pick the same adapter as MultipleAdapters (highest score).
+    a = PrefixAdapter("ACGTACGTACGT", max_errors=1, indels=True)
+    b = PrefixAdapter("ACGTACGTACA", max_errors=1, indels=True)
+    read = "ACGTACGTACAGTTTTTTTTT"
+    for adapters in ([a, b], [b, a]):
+        match = IndexedPrefixAdapters(adapters).match_to(read)
+        assert match.adapter is b
+        assert match.errors == 0
+        assert match.score == 11
+        assert MultipleAdapters(adapters).match_to(read).adapter is b
+
+
+def test_indexed_prefix_adapters_score_is_alignment_score():
+    a = PrefixAdapter("ACGTTGCAAC", max_errors=1, indels=True)
+    b = PrefixAdapter("GGATCCTTGA", max_errors=1, indels=True)
+    ipa = IndexedPrefixAdapters([a, b])
+    # one inserted T: ten matches, one indel
+    match = ipa.match_to("ACGTTTGCAACGGGGG")
+    assert match.adapter is a
+    assert match.errors == 1
+    assert match.score == 8
+    assert match.score == MultipleAdapters([a, b]).match_to("ACGTTTGCAACGGGGG").score
+    # one substitution: nine matches, one mismatch
+    match = ipa.match_to("ACGTTGCTACGGGGG")
+    assert match.adapter is a
+    assert match.errors == 1
+    assert match.score == 8
