+def test_hexbin_marginals_count_without_C():
+    # Without C, every point has a value of 1, so each marginal bar is the
+    # number of points in its strip (not the mean of ones, which is 1).
+    np.random.seed(19680801)
+    x, y = np.clip(np.random.standard_normal((2, 500)), -3.9, 3.9)
+    fig, ax = plt.subplots()
+    h = ax.hexbin(x, y, gridsize=(6, 3), extent=(-4, 4, -4, 4), marginals=True)
+    xcounts, _ = np.histogram(x, bins=6, range=(-4, 4))
+    ycounts, _ = np.histogram(y, bins=6, range=(-4, 4))
+    assert_array_equal(h.hbar.get_array(), xcounts[xcounts > 0])
+    assert_array_equal(h.vbar.get_array(), ycounts[ycounts > 0])
+
