+def test_stackplot_weighted_wiggle_baseline():
+    # 'weighted_wiggle' is the Streamgraph layout (Byron & Wattenberg, 2008),
+    # with the first layer at the bottom: at each step the baseline moves by
+    # -sum_i y_i * (dy_i / 2 + sum_{j<i} dy_j) / sum_i y_i.
+    x = np.arange(7)
+    y = np.array([[1, 1, 2, 3, 3, 2, 1],
+                  [1, 2, 3, 5, 4, 2, 2],
+                  [2, 1, 1, 1, 2, 4, 6]], dtype=float)
+    fig, ax = plt.subplots()
+    colls = ax.stackplot(x, y, baseline='weighted_wiggle')
+    baseline = colls[0].get_paths()[0].vertices[1:len(x) + 1, 1]
+    dy = np.diff(y, axis=1)
+    below = np.cumsum(dy, axis=0) - dy
+    steps = -(y[:, 1:] * (dy / 2 + below)).sum(0) / y[:, 1:].sum(0)
+    expected = -y[:, 0].sum() / 2 + np.concatenate([[0], np.cumsum(steps)])
+    assert_allclose(baseline, expected)
+    assert_allclose(baseline,
+                    [-2, -19/8, -29/8, -377/72, -353/72, -59/18, -3])
+
