+@pytest.mark.parametrize("shape", ["1d", "list", "2d"])
+def test_violin_stats_ignores_masked(shape):
+    np.random.seed(19680801)
+    clean = np.random.normal(size=40)
+    data = np.ma.masked_array(np.concatenate([clean, [50., -50., 3.3]]),
+                              mask=[False] * 40 + [True] * 3)
+    if shape == "list":
+        data = [data]
+    elif shape == "2d":
+        data = data[:, np.newaxis]
+    stats, = cbook.violin_stats(data, quantiles=[[0.25, 0.75]])
+    expected, = cbook.violin_stats(clean, quantiles=[[0.25, 0.75]])
+    for key in ["min", "max", "mean", "median"]:
+        assert stats[key] == expected[key]
+    for key in ["coords", "vals", "quantiles"]:
+        assert_array_equal(stats[key], expected[key])
+
