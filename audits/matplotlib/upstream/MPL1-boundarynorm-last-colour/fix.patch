+@pytest.mark.parametrize("ncolors, nbins", [(16, 12), (256, 26), (27, 24), (30, 26)])
+def test_BoundaryNorm_interpolation_reaches_last_color(ncolors, nbins):
+    # Stretching nbins regions over ncolors colors must map the last region to
+    # the last color; float rounding used to give ncolors - 2 for these pairs.
+    boundaries = np.arange(nbins + 1)
+    bn = mcolors.BoundaryNorm(boundaries, ncolors)
+    expected = (ncolors - 1) * np.arange(nbins) // (nbins - 1)
+    assert_array_equal(bn(boundaries[:-1] + 0.5), expected)
+    assert bn(nbins - 0.5) == ncolors - 1
+
