+import numpy as np
+import scipy.sparse
+
+from scrublet.helper_functions import subsample_counts
+
+
+def test_subsampled_totals_scale_with_rate():
+    # 2000 doublets, 1000 counts in the genes kept for scoring, 4000 in all genes
+    rng = np.random.RandomState(0)
+    E = scipy.sparse.csc_matrix(rng.multinomial(1000, np.full(50, 1 / 50), size=2000).astype(float))
+    original_totals = np.full(2000, 4000.0)
+    _, totals = subsample_counts(E, 0.5, original_totals, random_seed=0)
+    # expected 0.5 * 4000 = 2000 per doublet; the old code gave 2250
+    assert abs(totals.mean() - 2000) < 20
+
+
+def test_subsampled_counts_are_thinned():
+    rng = np.random.RandomState(0)
+    E = scipy.sparse.csc_matrix(rng.poisson(5, size=(500, 40)).astype(float))
+    before = E.sum()
+    E2, totals = subsample_counts(E.copy(), 0.5, E.sum(1).A.squeeze(), random_seed=0)
+    assert abs(E2.sum() / before - 0.5) < 0.02
+    # all genes kept, so the totals are exactly the thinned row sums
+    np.testing.assert_array_equal(totals, E2.sum(1).A.squeeze())
