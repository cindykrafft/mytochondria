@@ -175,9 +175,14 @@ def sparse_zscore(E, gene_mean=None, gene_stdev=None):
 def subsample_counts(E, rate, original_totals, random_seed=0):
     if rate < 1:
         np.random.seed(random_seed)
+        # The part of each original total that E does not contain (genes
+        # removed by the gene filter) has to be measured before thinning;
+        # measuring it after would resample the counts the thinning below
