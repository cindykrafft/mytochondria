From 74c80986497db627a383fc10fe35c759acd75d7b Mon Sep 17 00:00:00 2001
From: Mytochondria audit <audit@example.invalid>
Date: Wed, 9 Sep 2026 22:35:54 +0000
Subject: [PATCH] arrayWeights(method="reml") with prior weights: fix the
 convergence criterion

.arrayWeightsPrWtsREML averages the REML information matrix and score
over genes and then divides the Fisher-scoring convergence criterion by
(ngenes + prior.n) a second time, so the criterion is (ngenes+prior.n)
times smaller than in .arrayWeightsREML and the scoring stops after one
to three steps at the default tol = 1e-5.

arrayWeights(y, design, weights=matrix(1,...), method="reml") then
differs from arrayWeights(y, design, method="reml") on identical data by
up to 0.55 on 3000 genes x 9 arrays, and the returned weights are not
converged: an independent REML+prior score at them is 4.4e-02 against
3.0e-04 for the unweighted path. On voom data with real prior weights,
voomWithQualityWeights(method="reml") sample weights are 4% off the
converged fit.

Use the same per-gene criterion as .arrayWeightsREML, and add the
unit-weights case to tests/limma-Tests.R with its output in
limma-Tests.Rout.save.
---
 R/arrayWeightsPrWtsREML.R   |  6 ++++--
 tests/limma-Tests.R         | 10 ++++++++++
 tests/limma-Tests.Rout.save | 11 +++++++++++
 3 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/R/arrayWeightsPrWtsREML.R b/R/arrayWeightsPrWtsREML.R
index f76c7cb..69ce41e 100644
--- a/R/arrayWeightsPrWtsREML.R
+++ b/R/arrayWeightsPrWtsREML.R
@@ -4,7 +4,7 @@
 #	Uses an exact Fisher scoring algorithm similar to statmod::remlscor.
 #	Gordon Smyth
 #	Created 12 Feb 2019 from .arrayWeightsREML.
-#	Last revised 15 Feb 2019.
+#	Last revised 9 Sep 2026.
 {
 #	y should be a numeric matrix
 	narrays <- ncol(y)
@@ -74,7 +74,9 @@
 		w <- drop(exp(Z2 %*% (-gam)))
 
 #		Test for convergence
-		convcrit <- crossprod(dl,gamstep) / (ngenes+prior.n) / ngam
+#		info2 and z are already averaged per gene, so dl and gamstep are on the
+#		same scale as crossprod(dl,gamstep)/(ngenes+prior.n) in .arrayWeightsREML
+		convcrit <- crossprod(dl,gamstep) / ngam
 		if(trace) cat(iter,convcrit,range(w),"\n")
 		if(is.na(convcrit)) {
 			warning("convergence tolerance not achievable, stopping prematurely")
diff --git a/tests/limma-Tests.R b/tests/limma-Tests.R
index 29033e3..7544cbb 100755
--- a/tests/limma-Tests.R
+++ b/tests/limma-Tests.R
@@ -289,3 +289,13 @@ EB <- c("133746","1339","134","1340","134083","134111","134147","134187","134218
 go <- goana(fit,FDR=0.8,geneid=EB)
 topGO(go,number=10,truncate.term=30)
 topGO(go,number=10,truncate.term=30,sort="down")
+
+### arrayWeights with prior weights (REML)
+
+set.seed(12)
+sdv <- exp(c(-0.5,0,0.5,0,0,0,0.6,-0.6))
+yaw <- matrix(rnorm(500*8),500,8) * rep(sdv,each=500) + 6
+designaw <- cbind(1,rep(0:1,each=4))
+aw0 <- arrayWeights(yaw,designaw,method="reml")
+aw1 <- arrayWeights(yaw,designaw,weights=matrix(1,500,8),method="reml")
+all.equal(aw0,aw1,tolerance=1e-8)
diff --git a/tests/limma-Tests.Rout.save b/tests/limma-Tests.Rout.save
index 74d5143..c1f1205 100755
--- a/tests/limma-Tests.Rout.save
+++ b/tests/limma-Tests.Rout.save
@@ -1271,6 +1271,17 @@ GO:0003006 developmental process invol...  BP 3  0    2    1 0.025788497
 GO:0007276              gamete generation  BP 3  0    2    1 0.025788497
 GO:0007507              heart development  BP 3  0    2    1 0.025788497
