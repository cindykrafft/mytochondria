diff --git a/tests/arrayweights-reml.R b/tests/arrayweights-reml.R
new file mode 100644
index 0000000..f5ee3e9
--- /dev/null
+++ b/tests/arrayweights-reml.R
@@ -0,0 +1,17 @@
+library(limma)
+
+# arrayWeights(method="reml") with prior weights (.arrayWeightsPrWtsREML, C backend) must
+# iterate to the same tolerance as the weight-free REML fit: with a weight matrix of ones
+# the two routines fit the same model and must return the same array weights.
+
+set.seed(1)
+narrays <- 6
+ngenes <- 2000
+design <- cbind(Int=1, Group=rep(0:1, each=3))
+y <- matrix(rnorm(ngenes*narrays, sd=rep(c(2,1,0.5,2,1,0.5), each=ngenes)), ngenes, narrays) + 8
+w0 <- arrayWeights(y, design, method="reml")
+w1 <- arrayWeights(y, design, weights=matrix(1, ngenes, narrays), method="reml")
+w2 <- arrayWeights(y, design, weights=matrix(1, ngenes, narrays), method="reml", nthreads=2L)
+stopifnot(isTRUE(all.equal(w0, w1, tolerance=1e-10, check.attributes=FALSE)))
+stopifnot(isTRUE(all.equal(w1, w2, tolerance=1e-12, check.attributes=FALSE)))
+
