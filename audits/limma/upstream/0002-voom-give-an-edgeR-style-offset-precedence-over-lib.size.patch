 The \code{voom} method is similar in purpose to the limma-trend method, which uses \code{\link{eBayes}} or \code{\link{treat}} with \code{trend=TRUE}.
 The voom method incorporates the mean-variance trend into the precision weights, whereas limma-trend incorporates the trend into the empirical Bayes moderation.
diff --git a/tests/voom-offset.R b/tests/voom-offset.R
new file mode 100644
index 0000000..12cd4a9
--- /dev/null
+++ b/tests/voom-offset.R
@@ -0,0 +1,29 @@
+library(limma)
+
+# An edgeR-style offset matrix specifies the log effective library sizes directly, so an
+# offset equal to log(lib.size) must reproduce voom(counts, lib.size=lib.size), and a
+# gene-specific offset must give log2((counts+0.5)/(exp(offset)+1)*1e6), as in voomLmFit().
+
+set.seed(1)
+ngenes <- 100
+narrays <- 4
+counts <- matrix(rnbinom(ngenes*narrays, mu=100, size=10), ngenes, narrays)
+lib.size <- c(1e6, 4e6, 2e6, 8e6)
+offset <- matrix(log(lib.size), ngenes, narrays, byrow=TRUE)
+design <- cbind(1, c(0,0,1,1))
+v0 <- voom(counts, design, lib.size=lib.size)
+v1 <- voom(counts, design, offset=offset)
+stopifnot(isTRUE(all.equal(v0$E, v1$E)))
+# with lib.size also given, the mean-variance trend is fitted on the same scale, so the weights agree too
+v1 <- voom(counts, design, lib.size=lib.size, offset=offset)
+stopifnot(isTRUE(all.equal(v0$weights, v1$weights)))
+# vector offset
+v2 <- voom(counts, design, offset=log(lib.size))
+stopifnot(isTRUE(all.equal(v0$E, v2$E)))
+# gene-specific offset
+d <- matrix(rnorm(ngenes*narrays, 0, 0.2), ngenes, narrays)
+v3 <- voom(counts, design, offset=offset + d)
+stopifnot(isTRUE(all.equal(v3$E, log2((counts+0.5)/(exp(offset+d)+1)*1e6), check.attributes=FALSE)))
+# offset.prior adds to log(lib.size)
+v4 <- voom(counts, design, lib.size=lib.size, offset.prior=d)
+stopifnot(isTRUE(all.equal(v4$E, log2((counts+0.5)/(exp(offset+d)+1)*1e6), check.attributes=FALSE)))
