From 1776b1703c972d632c434fc884c87fa76b9abba8 Mon Sep 17 00:00:00 2001
From: Cindy Krafft <cynthiacondra@gmail.com>
Date: Thu, 24 Sep 2026 16:20:14 +0000
Subject: [PATCH 2/3] stats: count duplicates for the same records as
 "sequences"

"reads duplicated" and "bases duplicated" were accumulated before the
IS_ORIGINAL() gate in collect_stats(), so secondary and supplementary
records carrying the 0x400 flag were counted, while "sequences" and
"total length" exclude those records.  A duplication rate formed from the
two lines (MultiQC's samtools stats module does this) was therefore
overstated whenever the supplementary records of duplicates were flagged,
which is what `samtools markdup -S` and Picard MarkDuplicates produce.

The counting now happens inside the IS_ORIGINAL() block, next to the read
length counts, as suggested in #696.  On the new test input (20 reads,
8 duplicates, 4 supplementary records belonging to duplicate pairs) the old
code reported 10 duplicated reads and 860 duplicated bases against
20 sequences; the new code reports 8 and 800.  The regression test fails on
the previous code.

Fixes #696

Assisted-by: Claude:claude-fable-5-1
Signed-off-by: Cindy Krafft <cynthiacondra@gmail.com>
---
 NEWS.md                     |  7 +++++++
 stats.c                     | 14 ++++++++------
 test/stat/22.stats.expected |  5 +++++
 test/stat/22_dup_supp.sam   | 26 ++++++++++++++++++++++++++
 test/test.pl                |  2 ++
 5 files changed, 48 insertions(+), 6 deletions(-)
 create mode 100644 test/stat/22.stats.expected
 create mode 100644 test/stat/22_dup_supp.sam

diff --git a/NEWS.md b/NEWS.md
index 2a7f24d..016ee0b 100644
--- a/NEWS.md
+++ b/NEWS.md
@@ -27,6 +27,13 @@ Bug fixes:
   used byte lengths where element counts were required and could drop
   pending counts on mixed-length or long-read data.
 
+* FIX.  `samtools stats` counted secondary and supplementary records in
+  `reads duplicated` and `bases duplicated`, while `sequences` and
+  `total length` exclude them, so a duplication rate formed from those lines
+  (as MultiQC does) was overstated once `markdup -S` or Picard MarkDuplicates
+  had flagged the supplementary records of duplicates.  Duplicates are now
+  counted for the same records as `sequences`.
+
 Release 1.24 (9th July 2026)
 ----------------------------
 
diff --git a/stats.c b/stats.c
index a34ad39..c69e558 100644
--- a/stats.c
+++ b/stats.c
@@ -1275,12 +1275,6 @@ void collect_stats(bam1_t *bam_line, stats_t *stats, khash_t(qn2pair) *read_pair
     int seq_len = bam_line->core.l_qseq;
     if ( !seq_len ) return;
 
-    if ( IS_DUP(bam_line) )
-    {
-        stats->total_len_dup += seq_len;
-        stats->nreads_dup++;
-    }
-
     uint32_t order = IS_PAIRED(bam_line) ? (IS_READ1(bam_line) ? READ_ORDER_FIRST : 0) + (IS_READ2(bam_line) ? READ_ORDER_LAST : 0) : READ_ORDER_FIRST;
 
     int read_len = unclipped_length(bam_line);
@@ -1302,6 +1296,14 @@ void collect_stats(bam1_t *bam_line, stats_t *stats, khash_t(qn2pair) *read_pair
     // These stats should only be calculated for the original reads ignoring supplementary artificial reads
     // otherwise we'll accidentally double count
     if ( IS_ORIGINAL(bam_line) ) {
+        // Count duplicates here as well, so that "reads duplicated" and
+        // "bases duplicated" refer to the same reads as "sequences" and
+        // "total length" (secondary and supplementary records excluded).
+        if ( IS_DUP(bam_line) )
+        {
+            stats->total_len_dup += seq_len;
+            stats->nreads_dup++;
+        }
         stats->read_lengths[read_len]++;
         if ( order == READ_ORDER_FIRST ) stats->read_lengths_1st[read_len]++;
         if ( order == READ_ORDER_LAST ) stats->read_lengths_2nd[read_len]++;
