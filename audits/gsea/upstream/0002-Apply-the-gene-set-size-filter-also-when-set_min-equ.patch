+ */
+package edu.mit.broad.genome.alg.gsea;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import org.junit.jupiter.api.Test;
+
+import edu.mit.broad.genome.math.Vector;
+import edu.mit.broad.genome.objects.DefaultRankedList;
+import edu.mit.broad.genome.objects.GeneSet;
+import edu.mit.broad.genome.objects.RankedList;
+
+/**
+ * Unit tests for the gene set size filter applied before a GSEA run.
+ */
+public class GeneSetCohortGeneratorTest {
+    private static final int N = 30;
+
+    private static RankedList rankedList() {
+        List<String> names = new ArrayList<String>();
+        float[] scores = new float[N];
+        for (int i = 0; i < N; i++) {
+            names.add("g" + i);
+            scores[i] = N - i;
+        }
+        return new DefaultRankedList("rl", names, new Vector(scores));
+    }
+
+    private static GeneSet set(String name, int from, int to, String... extra) {
+        List<String> members = new ArrayList<String>();
+        for (int i = from; i < to; i++) { members.add("g" + i); }
+        members.addAll(Arrays.asList(extra));
+        return new GeneSet(name, name, members, true);
+    }
+
+    private static GeneSet[] sets() {
+        return new GeneSet[] {
+                set("size5", 0, 5),
+                set("size10", 0, 10),
+                set("size10_plus_absent", 10, 20, "not_in_list_1", "not_in_list_2"),
+                set("size20", 5, 25) };
+    }
+
+    private static Set<String> names(GeneSet[] gsets) {
+        Set<String> names = new HashSet<String>();
+        for (GeneSet gset : gsets) { names.add(gset.getName()); }
+        return names;
+    }
+
+    @Test
+    public void rangeIsInclusiveAndRestrictsSetsToTheRankedList() throws Exception {
+        GeneSetCohort.Generator gen = new GeneSetCohort.Generator(new GeneSetScoringTables.Weighted(), 5, 20);
+        GeneSet[] kept = gen.filterGeneSetsByMembersAndSize(rankedList(), sets());
+        assertEquals(new HashSet<String>(Arrays.asList("size5", "size10", "size10_plus_absent", "size20")), names(kept));
+        for (GeneSet gset : kept) {
+            assertEquals(gset.getNumMembers(), gset.getNumMembers(rankedList()), gset.getName() + " restricted to the ranked list");
+        }
+    }
+
+    @Test
+    public void equalMinAndMaxKeepsOnlySetsOfExactlyThatSize() throws Exception {
+        GeneSetCohort.Generator gen = new GeneSetCohort.Generator(new GeneSetScoringTables.Weighted(), 10, 10);
+        GeneSet[] kept = gen.filterGeneSetsByMembersAndSize(rankedList(), sets());
+        assertEquals(new HashSet<String>(Arrays.asList("size10", "size10_plus_absent")), names(kept));
+        for (GeneSet gset : kept) {
+            assertEquals(10, gset.getNumMembers(), gset.getName());
+            assertTrue(gset.getNumMembers(rankedList()) == 10, gset.getName() + " restricted to the ranked list");
+        }
+    }
+}
