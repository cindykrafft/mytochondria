From 8b6aea64c316cc8fac152b6fe7372fd0c921d7ca Mon Sep 17 00:00:00 2001
From: Mytochondria audit <cynthiacondra@gmail.com>
Date: Sun, 13 Sep 2026 05:38:21 +0000
Subject: [PATCH] Apply the gene set size filter also when set_min equals
 set_max

GeneSetCohort.Generator.filterGeneSetsByMembersAndSize skipped the min/max size filter
entirely when the two thresholds were equal, so e.g. -set_min 20 -set_max 20 analysed
every gene set of every size (the parameters are documented as excluding sets outside
the range), and, because the skipped branch is also where sets are restricted to the
identifiers present in the ranked list, a set with an identifier absent from the data
then failed the run with "No such name".  Run the two filters unconditionally.

Adds GeneSetCohortGeneratorTest.
---
 .../broad/genome/alg/gsea/GeneSetCohort.java  | 18 ++---
 .../alg/gsea/GeneSetCohortGeneratorTest.java  | 79 +++++++++++++++++++
 2 files changed, 87 insertions(+), 10 deletions(-)
 create mode 100644 src/test/java/edu/mit/broad/genome/alg/gsea/GeneSetCohortGeneratorTest.java

diff --git a/src/main/java/edu/mit/broad/genome/alg/gsea/GeneSetCohort.java b/src/main/java/edu/mit/broad/genome/alg/gsea/GeneSetCohort.java
index 894d69b..36ea09e 100755
--- a/src/main/java/edu/mit/broad/genome/alg/gsea/GeneSetCohort.java
+++ b/src/main/java/edu/mit/broad/genome/alg/gsea/GeneSetCohort.java
@@ -185,16 +185,14 @@ public class GeneSetCohort {
         public GeneSet[] filterGeneSetsByMembersAndSize(final RankedList rl, GeneSet[] gsets) throws Exception {
             if (geneSetMaxSize < geneSetMinSize) { throw new IllegalArgumentException("Max size cannot be less than min size"); }
 
-            if (geneSetMinSize != geneSetMaxSize) {
-                log.info("Got gsets: " + gsets.length + " now preprocessing them ... min: " + geneSetMinSize + " max: " + geneSetMaxSize);
-                gsets = GeneSetGenerators.removeGeneSetsSmallerThan(gsets, geneSetMinSize, rl);
-                log.info("Done preproc for smaller than: " + geneSetMinSize);
-                // TODO: eval for performance: no need to filter by RL here since we already did it in the min filter
-                gsets = GeneSetGenerators.removeGeneSetsLargerThan(gsets, geneSetMaxSize, rl);
-                log.info("Done preproc for larger than: " + geneSetMaxSize);
-           } else { // @note hack
-                log.info("Skipped gene set size filtering: max and min thresholds are equal");
-            }
+            // Always filter, also when min == max (only sets of exactly that size then qualify).  This is
+            // also where the gene sets are restricted to the members present in the ranked list.
+            log.info("Got gsets: " + gsets.length + " now preprocessing them ... min: " + geneSetMinSize + " max: " + geneSetMaxSize);
+            gsets = GeneSetGenerators.removeGeneSetsSmallerThan(gsets, geneSetMinSize, rl);
+            log.info("Done preproc for smaller than: " + geneSetMinSize);
+            // TODO: eval for performance: no need to filter by RL here since we already did it in the min filter
+            gsets = GeneSetGenerators.removeGeneSetsLargerThan(gsets, geneSetMaxSize, rl);
+            log.info("Done preproc for larger than: " + geneSetMaxSize);
 
             // Finally remove all 0 size gene sets (if min is 0 these will still be in there)
             gsets = removeAllZeroMemberSets(gsets);
diff --git a/src/test/java/edu/mit/broad/genome/alg/gsea/GeneSetCohortGeneratorTest.java b/src/test/java/edu/mit/broad/genome/alg/gsea/GeneSetCohortGeneratorTest.java
new file mode 100644
index 0000000..81c4970
--- /dev/null
+++ b/src/test/java/edu/mit/broad/genome/alg/gsea/GeneSetCohortGeneratorTest.java
@@ -0,0 +1,79 @@
+/*
