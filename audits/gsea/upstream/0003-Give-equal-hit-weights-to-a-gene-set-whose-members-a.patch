From d1c1f035ed8d3f7fb23aafeae30007a7fbc429be Mon Sep 17 00:00:00 2001
From: Mytochondria audit <cynthiacondra@gmail.com>
Date: Sun, 13 Sep 2026 05:45:59 +0000
Subject: [PATCH] Give equal hit weights to a gene set whose members all have a
 ranking score of 0

Under the weighted schemes the hit weight is |score|^p / N_R with N_R the sum over the
set's members.  When every member present in the ranked list has score 0 (e.g. a set of
unexpressed genes in a preranked list that assigns 0 to untested genes), N_R is 0, the hit
weight is 0/0 = NaN, and in KSCore the running sum turns NaN at the first hit.  Every later
comparison against the NaN is false, so the ES that survives is the running sum just before
the first hit, -(rank of first member) / (N - N_H), which only says where the block of zeros
sits, and it is reported with an NES, p-value and FDR (p = 0 when the block is low in the
list).  Equal scores mean equal weights, so use 1 / N_H for such a set, as the classic scheme
does, and log a warning that the set's score depends only on the position of the tied genes.

Adds ZeroWeightGeneSetTest.
---
 .../genome/alg/gsea/GeneSetScoringTables.java | 14 +++++
 .../alg/gsea/ZeroWeightGeneSetTest.java       | 61 +++++++++++++++++++
 2 files changed, 75 insertions(+)
 create mode 100644 src/test/java/edu/mit/broad/genome/alg/gsea/ZeroWeightGeneSetTest.java

diff --git a/src/main/java/edu/mit/broad/genome/alg/gsea/GeneSetScoringTables.java b/src/main/java/edu/mit/broad/genome/alg/gsea/GeneSetScoringTables.java
index 8f9f990..889f84c 100755
--- a/src/main/java/edu/mit/broad/genome/alg/gsea/GeneSetScoringTables.java
+++ b/src/main/java/edu/mit/broad/genome/alg/gsea/GeneSetScoringTables.java
@@ -91,6 +91,12 @@ public class GeneSetScoringTables {
         public float getMissScore(String name) { return misspoints; }
     }
 
+    private static void warnZeroWeight(final GeneSet gset, final RankedList rl) {
+        klog.warn("Every member of gene set {} present in ranked list {} has a ranking score of 0; its hits are"
+                + " given equal weights.  Its enrichment score depends only on where the tied genes sit in the list.",
+                gset.getName(), rl.getName());
+    }
+
     // Needed as cdna give some nans for the class metric
     private static final float _abs(float score) {
         return (Float.isFinite(score)) ? Math.abs(score) : 0.01f;
@@ -122,6 +128,7 @@ public class GeneSetScoringTables {
 
             final float nTotal = rankedList.getSize();
             this.miss_score = 1.0f / (nTotal - nhExpected);
+            if (totalWeight == 0) { warnZeroWeight(gset, rl); }
         }
 
         public String getName() { return NAME; }
@@ -133,6 +140,9 @@ public class GeneSetScoringTables {
         }
 
         public float getHitScore(final String name) {
+            // All members scored 0: |score|^p / N_R is 0/0.  Equal scores mean equal weights, so use 1 / N_H
+            // (the limit of the weighted scheme), instead of letting NaN into the running sum.
+            if (totalWeight == 0) { return 1.0f / nhExpected; }
             float score = rankedList.getScore(name);
             score = _abs(score);
             return score / totalWeight;
@@ -168,6 +178,7 @@ public class GeneSetScoringTables {
 
             final float nTotal = rankedList.getSize();
             this.miss_score = 1.0f / (nTotal - nhExpected);
+            if (totalWeight_sq == 0) { warnZeroWeight(gset, rl); }
         }
 
         public String getName() { return NAME; }
@@ -179,6 +190,7 @@ public class GeneSetScoringTables {
         }
 
         public float getHitScore(String name) {
+            if (totalWeight_sq == 0) { return 1.0f / nhExpected; } // see Weighted.getHitScore
             float score = rankedList.getScore(name);
             float hitScore = (score * score) / totalWeight_sq;
             return Float.isFinite(hitScore) ? hitScore : 0.000001f;
@@ -213,6 +225,7 @@ public class GeneSetScoringTables {
 
             final float nTotal = rankedList.getSize();
             this.miss_score = 1.0f / (nTotal - nhExpected);
+            if (totalWeight_sq == 0) { warnZeroWeight(gset, rl); }
         }
 
         public String getName() { return NAME; }
@@ -224,6 +237,7 @@ public class GeneSetScoringTables {
         }
 
         public float getHitScore(String name) {
+            if (totalWeight_sq == 0) { return 1.0f / nhExpected; } // see Weighted.getHitScore
             float score = rankedList.getScore(name);
             float ss = (float) Math.pow(score, 1.5);
             float hitScore = ss / totalWeight_sq;
diff --git a/src/test/java/edu/mit/broad/genome/alg/gsea/ZeroWeightGeneSetTest.java b/src/test/java/edu/mit/broad/genome/alg/gsea/ZeroWeightGeneSetTest.java
new file mode 100644
index 0000000..692a411
--- /dev/null
+++ b/src/test/java/edu/mit/broad/genome/alg/gsea/ZeroWeightGeneSetTest.java
@@ -0,0 +1,61 @@
+/*
