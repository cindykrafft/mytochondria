From d555eea1f51e6ac7e42cf657cff910838e86d03d Mon Sep 17 00:00:00 2001
From: Cynthia Condra <cynthiacondra@gmail.com>
Date: Thu, 3 Sep 2026 23:36:34 +0000
Subject: [PATCH] bf: mri_convert --out_orientation keeps the field of view
 fixed

The output template copies the input header and then only rewrites the
direction cosines for --out_orientation (and --out_{i,j,k}_direction),
leaving c_ras unchanged.  c_ras is the RAS position of voxel
(W/2,H/2,D/2), half a voxel off the true FOV center for even
dimensions, so flipping an axis while keeping it shifts the output grid
by one voxel along that axis: the first slice samples outside the input
(a plane of zeros) and reorienting back loses a slice.  Remember the FOV
center before the cosines change and re-derive c_ras from it after, as
MRIreorderVox2RAS() already does.  --out_orientation LIA now matches
--reorder -1 3 -2 exactly and the LIA->RAS round trip restores the
input.

Adds a check to mri_convert/test.sh on the conformed reference volume.

Fixes #1358.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TaHntBDKuZJpMAAMenkC44
---
 mri_convert/mri_convert.cpp | 42 +++++++++++++++++++++++++++++++++++++
 mri_convert/test.sh         | 11 ++++++++++
 2 files changed, 53 insertions(+)

diff --git a/mri_convert/mri_convert.cpp b/mri_convert/mri_convert.cpp
index 684f8a8..44daf01 100644
--- a/mri_convert/mri_convert.cpp
+++ b/mri_convert/mri_convert.cpp
@@ -3029,6 +3029,35 @@ int main(int argc, char *argv[])
     mri_template->depth = out_n_k;
     mri_template->imnr1 = mri_template->imnr0 + out_n_k - 1;
   }
+  /* ----- keep the field of view fixed when the direction cosines change ----- */
+  /* c_ras is the RAS coordinate of voxel (W/2,H/2,D/2), which for even
+     dimensions lies half a voxel away from the true center of the field
+     of view at ((W-1)/2,(H-1)/2,(D-1)/2). Leaving c_ras untouched while
+     --out_orientation or --out_{i,j,k}_direction flips an axis therefore
+     shifts the output grid by one full voxel along that axis, so the
+     first slice samples outside the input (github issue #1358).
+     MRIreorder() keeps the FOV fixed; do the same here by remembering the
+     FOV center before the cosines change and re-deriving c_ras after. */
+  int dircos_change_flag = (out_orientation_flag || out_i_direction_flag ||
+                            out_j_direction_flag || out_k_direction_flag);
+  double fov_center[3] = {0.0, 0.0, 0.0};
+  if (dircos_change_flag)
+  {
+    MATRIX *vox2ras = MRIxfmCRS2XYZ(mri_template, 0);
+    MATRIX *crs = MatrixAlloc(4, 1, MATRIX_REAL);
+    crs->rptr[1][1] = (mri_template->width - 1) / 2.0;
+    crs->rptr[2][1] = (mri_template->height - 1) / 2.0;
+    crs->rptr[3][1] = (mri_template->depth - 1) / 2.0;
+    crs->rptr[4][1] = 1.0;
+    MATRIX *ras = MatrixMultiplyD(vox2ras, crs, NULL);
+    for (int n = 0; n < 3; n++)
+    {
+      fov_center[n] = ras->rptr[n + 1][1];
+    }
+    MatrixFree(&vox2ras);
+    MatrixFree(&crs);
+    MatrixFree(&ras);
+  }
   if (out_i_direction_flag)
   {
     mri_template->x_r = out_i_directions[0];
@@ -3052,6 +3081,19 @@ int main(int argc, char *argv[])
     printf("Setting output orientation to %s\n",out_orientation_string);
     MRIorientationStringToDircos(mri_template, out_orientation_string);
   }
+  if (dircos_change_flag)
+  {
+    /* c_ras = FOV center + Mdc * D * (1/2, 1/2, 1/2) with the new cosines */
+    mri_template->c_r = fov_center[0] + 0.5 * (mri_template->x_r * mri_template->xsize +
+                                               mri_template->y_r * mri_template->ysize +
+                                               mri_template->z_r * mri_template->zsize);
+    mri_template->c_a = fov_center[1] + 0.5 * (mri_template->x_a * mri_template->xsize +
+                                               mri_template->y_a * mri_template->ysize +
+                                               mri_template->z_a * mri_template->zsize);
+    mri_template->c_s = fov_center[2] + 0.5 * (mri_template->x_s * mri_template->xsize +
+                                               mri_template->y_s * mri_template->ysize +
+                                               mri_template->z_s * mri_template->zsize);
+  }
   if(out_center_flag)
   {
     mri_template->c_r = out_center[0];
diff --git a/mri_convert/test.sh b/mri_convert/test.sh
index 8c68f5d..a05cd10 100755
--- a/mri_convert/test.sh
+++ b/mri_convert/test.sh
@@ -8,6 +8,17 @@ FSTEST_NO_DATA_RESET=1 && init_testdata
 test_command mri_convert indata/rawavg.mgz rawavg-conform.mgz --conform
 compare_vol rawavg-conform.mgz indata/ref/rawavg-conform.ref.mgz
 
+# --out_orientation must keep the field of view fixed: flipping an axis used to
+# shift the output grid by one voxel, so the first slice sampled outside the input
+# and a round trip lost a slice on every flipped axis (github issue #1358).
+# The reoriented volume must equal the pure axis reordering, and reorienting it
+# back must restore the input exactly.
+test_command mri_convert indata/ref/rawavg-conform.ref.mgz reorient-ras.mgz --out_orientation RAS -rt nearest
+test_command mri_convert indata/ref/rawavg-conform.ref.mgz reorder-ras.mgz --reorder -1 -3 2
+compare_vol reorient-ras.mgz reorder-ras.mgz
+test_command mri_convert reorient-ras.mgz roundtrip-lia.mgz --out_orientation LIA -rt nearest
+compare_vol roundtrip-lia.mgz indata/ref/rawavg-conform.ref.mgz
+
 # dicom
 test_command mri_convert dcm/261000-10-60.dcm dicom.mgz
 compare_vol dicom.mgz indata/ref/freesurfer.mgz --geo-thresh 0.000008
-- 
