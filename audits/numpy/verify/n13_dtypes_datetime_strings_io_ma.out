ok   np.strings.str_len == len() for every test string (code points, astral plane counts 1)
ok   np.strings.add == + and multiply by 0, -1, 3 == Python s * n (negative -> '')
ok   np.strings.encode('utf-8') == str.encode and decode round-trips
