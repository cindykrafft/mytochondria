 source/Transcriptome_alignExonOverlap.cpp     |  2 +-
 source/Transcriptome_classifyAlign.cpp        |  2 +-
 source/Transcriptome_geneFullAlignOverlap.cpp |  8 ++--
 ...me_geneFullAlignOverlap_ExonOverIntron.cpp |  4 +-
 source/Transcriptome_quantAlign.cpp           |  2 +-
 7 files changed, 56 insertions(+), 9 deletions(-)
 create mode 100755 extras/tests/scripts/testStrandlessTranscript.sh

