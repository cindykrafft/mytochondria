diff --git a/extras/tests/scripts/testStrandlessTranscript.sh b/extras/tests/scripts/testStrandlessTranscript.sh
new file mode 100755
index 0000000..7d7ea67
--- /dev/null
+++ b/extras/tests/scripts/testStrandlessTranscript.sh
@@ -0,0 +1,43 @@
+#!/bin/bash
+# Regression test: a transcript whose GTF strand is '.' must be treated like '+' in
+# Aligned.toTranscriptome.out.bam (same strand flag as with a '+' annotation), and
+# STARsolo --soloStrand Forward must count reads on such a gene.
+# usage: bash testStrandlessTranscript.sh /path/to/STAR   (needs samtools in PATH)
+set -e
+STAR=${1:-STAR}
+T=$(mktemp -d); cd "$T"
+# 6-kb genome from a fixed-seed LCG, one two-exon transcript 1001-1400 / 2001-2400 with a GT..AG intron
+awk 'BEGIN{srand(1); n["0"]="A";n["1"]="C";n["2"]="G";n["3"]="T"; s="";
+  for(i=1;i<=6000;i++){s=s n[int(rand()*4)]};
+  s=substr(s,1,1400) "GT" substr(s,1403,598) "AG" substr(s,2003);
+  print ">chr1"; for(i=1;i<=6000;i+=80) print substr(s,i,80);
+  tr=substr(s,1001,400) substr(s,2001,400); print tr > "tr.txt"}' > genome.fa
+TR=$(cat tr.txt)
+comp() { echo "$1" | rev | tr ACGT TGCA; }
+# 4 reads: two sense, two antisense, 100 nt each
+printf "@s1\n%s\n+\n%s\n@s2\n%s\n+\n%s\n@a1\n%s\n+\n%s\n@a2\n%s\n+\n%s\n" \
+  "${TR:20:100}" "$(printf 'I%.0s' $(seq 100))" "${TR:300:100}" "$(printf 'I%.0s' $(seq 100))" \
+  "$(comp ${TR:60:100})" "$(printf 'I%.0s' $(seq 100))" "$(comp ${TR:500:100})" "$(printf 'I%.0s' $(seq 100))" > reads.fq
+# solo reads: 4 sense cDNA reads, one cell barcode, distinct UMIs
+printf "@c1\n%s\n+\n%s\n@c2\n%s\n+\n%s\n@c3\n%s\n+\n%s\n@c4\n%s\n+\n%s\n" \
+  "${TR:30:100}" "$(printf 'I%.0s' $(seq 100))" "${TR:130:100}" "$(printf 'I%.0s' $(seq 100))" \
+  "${TR:230:100}" "$(printf 'I%.0s' $(seq 100))" "${TR:330:100}" "$(printf 'I%.0s' $(seq 100))" > cdna.fq
+CB=ACGTACGTACGTACGT
+printf "@c1\n${CB}AACCGGTTAC\n+\n%s\n@c2\n${CB}CCGGTTAACG\n+\n%s\n@c3\n${CB}GGTTAACCGT\n+\n%s\n@c4\n${CB}TTAACCGGTA\n+\n%s\n" \
+  "$(printf 'I%.0s' $(seq 26))" "$(printf 'I%.0s' $(seq 26))" "$(printf 'I%.0s' $(seq 26))" "$(printf 'I%.0s' $(seq 26))" > bc.fq
+fail=0
+for strand in + .; do
+  d=g_$strand; printf 'chr1\tt\texon\t1001\t1400\t.\t%s\t.\tgene_id "G"; transcript_id "T";\nchr1\tt\texon\t2001\t2400\t.\t%s\t.\tgene_id "G"; transcript_id "T";\n' $strand $strand > $d.gtf
+  $STAR --runMode genomeGenerate --genomeDir $d --genomeFastaFiles genome.fa --sjdbGTFfile $d.gtf --sjdbOverhang 99 --genomeSAindexNbases 4 --outFileNamePrefix $d/ > /dev/null
+  $STAR --genomeDir $d --readFilesIn reads.fq --quantMode TranscriptomeSAM --outSAMtype None --outFileNamePrefix tr_$d/ > /dev/null
+  samtools view tr_$d/Aligned.toTranscriptome.out.bam | cut -f1,2,4 | sort > tr_$d.txt
+  $STAR --genomeDir $d --readFilesIn cdna.fq bc.fq --soloType CB_UMI_Simple --soloCBwhitelist None --soloStrand Forward --soloFeatures Gene GeneFull GeneFull_Ex50pAS --outSAMtype None --outFileNamePrefix solo_$d/ > /dev/null
+  for f in Gene GeneFull GeneFull_Ex50pAS; do echo "$f $(grep -v '^%' solo_$d/Solo.out/$f/raw/matrix.mtx | tail -n +2 | awk '{s+=$3} END{print s+0}')"; done > solo_$d.txt
+done
+echo "transcriptome records (read, flag, pos) with '+' annotation:"; cat tr_g_+.txt
+echo "with '.' annotation:"; cat tr_g_..txt
+if cmp -s tr_g_+.txt tr_g_..txt; then echo "PASS: transcriptome strand identical for '+' and '.' annotations"; else echo "FAIL: transcriptome records differ between '+' and '.' annotations"; fail=1; fi
+echo "STARsolo --soloStrand Forward UMI counts, '+' annotation:"; cat solo_g_+.txt; echo "'.' annotation:"; cat solo_g_..txt
+if cmp -s solo_g_+.txt solo_g_..txt; then echo "PASS: STARsolo counts identical for '+' and '.' annotations"; else echo "FAIL: STARsolo counts differ between '+' and '.' annotations"; fail=1; fi
+rm -rf "$T"
+exit $fail
