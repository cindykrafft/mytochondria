 docs/release-notes/3809.fix.md   |  1 +
 src/scanpy/neighbors/__init__.py | 15 ++++++++----
 tests/test_neighbors.py          | 39 ++++++++++++++++++++++++++------
 3 files changed, 43 insertions(+), 12 deletions(-)
 create mode 100644 docs/release-notes/3809.fix.md

diff --git a/docs/release-notes/3809.fix.md b/docs/release-notes/3809.fix.md
new file mode 100644
index 00000000..aa99ebf9
--- /dev/null
+++ b/docs/release-notes/3809.fix.md
@@ -0,0 +1 @@
+Fix {func}`~scanpy.pp.neighbors` storing `n_neighbors` instead of `n_neighbors - 1` neighbors per cell in `.obsp["distances"]` when a kNN transformer is used (the default for ≥ 8192 cells), so `distances` now matches `connectivities` again {smaller}`C Krafft`
diff --git a/src/scanpy/neighbors/__init__.py b/src/scanpy/neighbors/__init__.py
index 3197a6b4..e327b3b9 100644
--- a/src/scanpy/neighbors/__init__.py
+++ b/src/scanpy/neighbors/__init__.py
@@ -600,12 +600,17 @@ class Neighbors:
         if shortcut:
             # self._distances is a sparse matrix with a diag of 1, fix that
             self._distances[np.diag_indices_from(self.distances)] = 0
-            if knn:  # remove too far away entries in self._distances
-                self._distances = _get_sparse_matrix_from_indices_distances(
-                    knn_indices, knn_distances, keep_self=False
-                )
-            else:  # convert to dense
+            if not knn:  # convert to dense
                 self._distances = self._distances.toarray()
+        if knn:
+            # Restrict `self._distances` to the `n_neighbors - 1` nearest neighbors
+            # used for the connectivities. Transformers can return more entries per row,
+            # e.g. `PyNNDescentTransformer` returns `n_neighbors` neighbors plus the cell
+            # itself, which would leave one neighbor more in `.distances` than in
+            # `.connectivities`.
+            self._distances = _get_sparse_matrix_from_indices_distances(
+                knn_indices, knn_distances, keep_self=False
+            )
         if index := getattr(transformer, "index_", None):
             from pynndescent import NNDescent
 
