+package org.usadellab.trimmomatic.trim;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.junit.jupiter.api.Test;
+import org.usadellab.trimmomatic.fastq.FastqRecord;
+
+/**
+ * MAXINFO with a large target length: the fixed-point score tables must not overflow, so a
+ * high-quality read longer than the target is kept whole.
+ */
+public class MaximumInformationTrimmerLargeTargetTest {
+	private String makeSequence(int len) {
+		StringBuilder sb = new StringBuilder(len);
+		String pattern = "ACGT";
+		for (int i = 0; i < len; i++)
+			sb.append(pattern.charAt(i % 4));
+		return sb.toString();
+	}
+
+	private String makeQuality(char c, int len) {
+		StringBuilder sb = new StringBuilder(len);
+		for (int i = 0; i < len; i++)
+			sb.append(c);
+		return sb.toString();
+	}
+
+	private int survivingLength(String args, String qual) {
+		MaximumInformationTrimmer trimmer = new MaximumInformationTrimmer(args);
+		FastqRecord rec = new FastqRecord("head", makeSequence(qual.length()), "", qual, 33);
+		FastqRecord result = trimmer.processRecord(rec);
+		assertNotNull(result);
+		return result.getLength();
+	}
+
+	@Test
+	public void testTargetLength250LowStrictnessKeepsHighQualityRead() {
+		// 300 x Q40, target 250, strictness 0.1: nothing to trim
+		assertEquals(300, survivingLength("250:0.1", makeQuality('I', 300)));
+	}
+
+	@Test
+	public void testTargetLength500KeepsHighQualityRead() {
+		assertEquals(300, survivingLength("500:0.2", makeQuality('I', 300)));
+	}
+
+	@Test
+	public void testTargetLengthBeyondExpRangeKeepsHighQualityRead() {
+		// target 800: exp(800 - i - 1) overflows a double for short reads
+		assertEquals(300, survivingLength("800:0.5", makeQuality('I', 300)));
+	}
+
+	@Test
+	public void testLowQualityTailStillTrimmedAtTypicalSettings() {
+		// 100 x Q40 then 50 x Q2, target 40, strictness 0.8: the tail goes, the head stays
+		int len = survivingLength("40:0.8", makeQuality('I', 100) + makeQuality('#', 50));
+		assertTrue(len >= 90 && len <= 110, "surviving length " + len);
+	}
+}
