From e0b8d5c33e3409adce894670cb08e0a9add4eea4 Mon Sep 17 00:00:00 2001
From: Cynthia Condra <cynthiacondra@gmail.com>
Date: Thu, 3 Sep 2026 04:02:39 +0000
Subject: [PATCH] plotFingerprint: credit only the covered bases of a
 fragment's last bin

SumCoveragePerBin.get_coverage_of_region added a full tile to every bin up to the ceiling bin of the fragment end, so a fragment ending inside a bin credited that bin with the whole tile; the branch meant for the partial last bin only ever added max(0, negative). The path is taken when the sampling step equals --binSize (a single multi-bin region per chunk). Replace the three-part bookkeeping by the per-bin overlap.

Found in a source-level correctness audit of research software (methods and harnesses: https://github.com/cindykrafft/research-software-audit/tree/claude/software-package-audit-ablwee/audits/deeptools)
---
 CHANGES.txt                              |  3 +++
 deeptools/sumCoveragePerBin.py           | 29 ++++--------------------
 deeptools/test/test_sumCoveragePerBin.py | 18 +++++++++++++++
 3 files changed, 26 insertions(+), 24 deletions(-)
 create mode 100644 deeptools/test/test_sumCoveragePerBin.py

diff --git a/CHANGES.txt b/CHANGES.txt
index 5f0bf0f0..92063519 100755
--- a/CHANGES.txt
+++ b/CHANGES.txt
@@ -1,3 +1,6 @@
+unreleased
+* plotFingerprint: per-bin coverage sums no longer credit a fragment's last bin with a whole tile when the sampling step equals --binSize
+
 3.5.5
 * drop support for python 3.7
 * doc fixes (argparse properly displayed, minor changes in installation instructions)
diff --git a/deeptools/sumCoveragePerBin.py b/deeptools/sumCoveragePerBin.py
index 9cde4555..0f129d0b 100644
--- a/deeptools/sumCoveragePerBin.py
+++ b/deeptools/sumCoveragePerBin.py
@@ -167,35 +167,16 @@ class SumCoveragePerBin(countReadsPerBin.CountReadsPerBin):
                         fragmentEnd = reg[0] + len(coverages) * tileSize
 
                     sIdx = vector_start + max((fragmentStart - reg[0]) // tileSize, 0)
-                    eIdx = vector_start + min(np.ceil(float(fragmentEnd - reg[0]) / tileSize).astype('int'), nRegBins)
-                    if eIdx >= len(coverages):
-                        eIdx = len(coverages) - 1
+                    eIdx = vector_start + min(int(np.ceil(float(fragmentEnd - reg[0]) / tileSize)), nRegBins)
                     if last_eIdx is not None:
                         sIdx = max(last_eIdx, sIdx)
                         if sIdx >= eIdx:
                             continue
 
-                    # First bin
-                    if fragmentEnd < reg[0] + (sIdx + 1) * tileSize:
-                        _ = fragmentEnd - fragmentStart
-                    else:
-                        _ = reg[0] + (sIdx + 1) * tileSize - fragmentStart
-                    if _ > tileSize:
-                        _ = tileSize
-                    coverages[sIdx] += _
-                    _ = sIdx + 1
-                    while _ < eIdx:
-                        coverages[_] += tileSize
-                        _ += 1
-                    while eIdx - sIdx >= nRegBins:
-                        eIdx -= 1
-                    if eIdx > sIdx:
-                        _ = fragmentEnd - (reg[0] + eIdx * tileSize)
-                        if _ > tileSize:
-                            _ = tileSize
-                        elif _ < 0:
-                            _ = 0
-                        coverages[eIdx] += _
+                    # add to every bin the number of its bases the fragment covers
+                    for binIdx in range(int(sIdx), int(eIdx)):
+                        binStart = reg[0] + (binIdx - vector_start) * tileSize
+                        coverages[binIdx] += min(fragmentEnd, binStart + tileSize) - max(fragmentStart, binStart)
                     last_eIdx = eIdx
 
                 c += 1
diff --git a/deeptools/test/test_sumCoveragePerBin.py b/deeptools/test/test_sumCoveragePerBin.py
new file mode 100644
index 00000000..3ce7bcfb
--- /dev/null
+++ b/deeptools/test/test_sumCoveragePerBin.py
@@ -0,0 +1,18 @@
+import os
+import numpy as np
+import numpy.testing as nt
+import pysam
+from deeptools.sumCoveragePerBin import SumCoveragePerBin
+
+ROOT = os.path.dirname(os.path.abspath(__file__)) + "/test_data/"
+
+
+def test_sum_coverage_partial_bins():
+    """
+    testB.bam: reads 50-100, 100-150 and twice 150-200 on 3R. With 40-bp bins
+    each fragment ends inside a bin; the bin sums are the covered bases
+    (0, 30, 20+20, 30+10+10, 40+40), not a whole tile for the last bin.
+    """
+    c = SumCoveragePerBin([], stepSize=40, binLength=40)
+    cov = c.get_coverage_of_region(pysam.AlignmentFile(ROOT + "testB.bam"), '3R', [(0, 200, 40)])
+    nt.assert_equal(cov, np.array([0., 30., 40., 50., 80.]))
-- 
