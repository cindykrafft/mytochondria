From 3fb4844be73c094a342e931f0249362388520c02 Mon Sep 17 00:00:00 2001
From: Cynthia Condra <cynthiacondra@gmail.com>
Date: Thu, 3 Sep 2026 04:02:39 +0000
Subject: [PATCH] bamCoverage/bamCompare: count --ignoreDuplicates in the
 normalisation denominator

fraction_kept returned 1.0 early whenever --minMappingQuality, --samFlagInclude/Exclude and --min/maxFragmentLength were all unset, without looking at --ignoreDuplicates. The per-bin counts were deduplicated but the number of mapped reads used by --normalizeUsing (CPM, RPKM, RPGC, BPM) and by --scaleFactorsMethod readCount was not, unless some other filter happened to be set; --exactScaling could not override the early return.

Found in a source-level correctness audit of research software (methods and harnesses: https://github.com/cindykrafft/research-software-audit/tree/claude/software-package-audit-ablwee/audits/deeptools)
---
 CHANGES.txt                                       |  3 +++
 deeptools/getScaleFactor.py                       |  3 ++-
 deeptools/test/test_bamCoverage_and_bamCompare.py | 15 +++++++++++++++
 3 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/CHANGES.txt b/CHANGES.txt
index 5f0bf0f0..d304c7c5 100755
--- a/CHANGES.txt
+++ b/CHANGES.txt
@@ -1,3 +1,6 @@
+unreleased
+* bamCoverage/bamCompare: --ignoreDuplicates given without any other read filter now also removes the duplicates from the number of mapped reads used by --normalizeUsing and --scaleFactorsMethod readCount
+
 3.5.5
 * drop support for python 3.7
 * doc fixes (argparse properly displayed, minor changes in installation instructions)
diff --git a/deeptools/getScaleFactor.py b/deeptools/getScaleFactor.py
index 541b4feb..000c9ade 100644
--- a/deeptools/getScaleFactor.py
+++ b/deeptools/getScaleFactor.py
@@ -127,7 +127,8 @@ def fraction_kept(args, stats):
        (not args.samFlagInclude or args.samFlagInclude == 0) and \
        (not args.samFlagExclude or args.samFlagExclude == 0) and \
        (not args.minFragmentLength or args.minFragmentLength == 0) and \
-       (not args.maxFragmentLength or args.maxFragmentLength == 0):
+       (not args.maxFragmentLength or args.maxFragmentLength == 0) and \
+       not getattr(args, "ignoreDuplicates", False):
         if hasattr(args, "filterRNAstrand"):
             if args.filterRNAstrand not in ["forward", "reverse"]:
                 return 1.0
diff --git a/deeptools/test/test_bamCoverage_and_bamCompare.py b/deeptools/test/test_bamCoverage_and_bamCompare.py
index ac1f23ce..3bbecd65 100644
--- a/deeptools/test/test_bamCoverage_and_bamCompare.py
+++ b/deeptools/test/test_bamCoverage_and_bamCompare.py
@@ -460,3 +460,18 @@ def test_bam_compare_filter_blacklist():
                     '3R\t1050\t1500\t0\n']
         assert f"{resp}" == f"{expected}", f"{resp} != {expected}"
         unlink(outfile)
+
+
+def test_get_num_kept_reads_ignore_duplicates():
+    """
+    --ignoreDuplicates on its own must reduce the number of reads used for
+    the normalisation, exactly as it does when another (no-op) filter is
+    also given. test_filtering.bam carries position duplicates.
+    """
+    args = bam_cov.process_args("--bam {} -o /tmp/test --ignoreDuplicates".format(BAMFILE_FILTER1).split())
+    kept_dup, total = gs.get_num_kept_reads(args, None)
+    args = bam_cov.process_args("--bam {} -o /tmp/test --ignoreDuplicates --samFlagExclude 4".format(BAMFILE_FILTER1).split())
+    kept_dup_and_noop, total2 = gs.get_num_kept_reads(args, None)
+    assert total == total2
+    assert kept_dup < total, "duplicates were not removed from the normalisation count"
+    assert abs(kept_dup - kept_dup_and_noop) < 1e-6, (kept_dup, kept_dup_and_noop)
-- 
2.43.0

