From 42ca328f134c0eb69a565d8fc05a3f30a59482c8 Mon Sep 17 00:00:00 2001
From: Cindy Krafft <cynthiacondra@gmail.com>
Date: Wed, 2 Sep 2026 06:10:28 +0000
Subject: [PATCH] Keep chain order stable across a to_json / from_json round
 trip

to_json grouped chains by content across the whole input, so two identical
chains separated by a different chain were emitted together and the chain
between them moved after them. from_json rebuilds Input.chains in the order the
sequences are emitted, so the round trip reordered the input.

That matters because chain order is load-bearing: to_structure lays out tokens
in chain order, and _compute_asym_entity_and_sym_id assigns asym_id, entity_id
and sym_id by first appearance in that layout. run_alphafold.py always writes
<name>_data.json with to_json, so in the documented two-stage workflow (data
pipeline with --norun_inference, then inference from that JSON) the model saw a
different token order and different asym_ids than a single end-to-end run of the
same input with the same seed.

For a homodimer with a ligand between the copies, A,B,C came back as A,C,B.

Merge only consecutive content-identical chains, which keeps the emitted order
faithful. Interleaved copies are now written as separate entries.
---
 src/alphafold3/common/folding_input.py | 20 ++++++++++++++------
 1 file changed, 14 insertions(+), 6 deletions(-)

diff --git a/src/alphafold3/common/folding_input.py b/src/alphafold3/common/folding_input.py
index f0eff1e..f143e90 100644
--- a/src/alphafold3/common/folding_input.py
+++ b/src/alphafold3/common/folding_input.py
@@ -1484,15 +1484,23 @@ class Input:
 
   def to_json(self) -> str:
     """Converts Input to an AlphaFold JSON."""
-    deduped_chains = {}
-    deduped_chain_ids = {}
+    # Merge only *consecutive* content-identical chains. Merging chains that are
+    # separated by a different chain would emit that chain after them, and
+    # from_json rebuilds Input.chains in the order the sequences are emitted.
+    # Chain order fixes the token order and the asym_id/entity_id/sym_id
+    # assignment, so a round trip through to_json must not reorder chains.
+    grouped_chains = []
     for chain in self.chains:
-      deduped_chains[chain.hash_without_id()] = chain
-      deduped_chain_ids.setdefault(chain.hash_without_id(), []).append(chain.id)
+      if (
+          grouped_chains
+          and grouped_chains[-1][0].hash_without_id() == chain.hash_without_id()
+      ):
+        grouped_chains[-1][1].append(chain.id)
+      else:
+        grouped_chains.append((chain, [chain.id]))
 
     sequences = []
-    for chain_content_hash, ids in deduped_chain_ids.items():
-      chain = deduped_chains[chain_content_hash]
+    for chain, ids in grouped_chains:
       sequences.append(chain.to_dict(seq_id=ids if len(ids) > 1 else ids[0]))
 
     alphafold_json = json.dumps(
