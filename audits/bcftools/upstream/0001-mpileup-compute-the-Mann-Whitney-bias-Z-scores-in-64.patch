From 22e3099fb92ebb21aa476e1741e5580b4dc5959f Mon Sep 17 00:00:00 2001
From: Mytochondria audit <audit@example.invalid>
Date: Thu, 10 Sep 2026 14:34:01 +0000
Subject: [PATCH] mpileup: compute the Mann-Whitney bias Z scores in 64 bits

calc_mwu_biasZ() accumulated the tie correction, the U score and the group
sizes in `int`.  The tie correction sums p^3-p over the quality or position
bins, where p is the number of reads in a bin, so a single bin of 1291 reads
takes the term past INT32_MAX.  The wrap is always downward, which inflates
var2 and shrinks the reported |Z|: a site with a real mapping-quality, base-
quality, read-position or soft-clip bias is annotated as less biased than it
is, never more.

The bias histograms are filled once per site across all input files
(bcf_callaux_clean() is called per site, not per sample), so the threshold is
on the total number of reads at the site: 1291 reads in one bin.  Because
bam2bcf.c caps MQ at bin 59 and most aligners give the same maximum MQ to
nearly every read, the top bin usually holds almost the whole pileup, and a
30-sample pileup at 100x already crosses it.  Measured on a synthetic pileup
of 3000 reads over 30 files, INFO/MQBZ was reported as -6.88 where the
tie-corrected Mann-Whitney Z is -31.08.  Sweeping realistic pileups, 41 of 160
changed their verdict under the `MQBZ < -3` cut used in the calling workflow.

e, l, na, nb and the per-bin p are now int64_t, which also removes the
overflow of na*nb in the mean and variance at very high depth.

test/test-mwu.c checks calc_mwu_biasZ() either side of the 1291-read boundary
and on a 30-sample pileup; it fails on the unmodified code.

Assisted-by: Claude:claude-opus-5
---
 Makefile        |  9 +++++-
 NEWS            | 10 ++++++
 bam2bcf.c       | 14 +++++---
 test/test-mwu.c | 85 +++++++++++++++++++++++++++++++++++++++++++++++++
 4 files changed, 112 insertions(+), 6 deletions(-)
 create mode 100644 test/test-mwu.c

diff --git a/Makefile b/Makefile
index 34fd97b4..acec7595 100644
--- a/Makefile
+++ b/Makefile
@@ -80,7 +80,7 @@ MISC_SCRIPTS = \
     misc/run-roh.pl \
     misc/vcfutils.pl \
     misc/vrfs-variances
-TEST_PROGRAMS = test/test-rbuf test/test-regidx
+TEST_PROGRAMS = test/test-rbuf test/test-regidx test/test-mwu
 
 ALL_CPPFLAGS = -I. $(HTSLIB_CPPFLAGS) $(CPPFLAGS)
 ALL_LDFLAGS  = $(HTSLIB_LDFLAGS) $(LDFLAGS)
@@ -326,11 +326,13 @@ csq.o: csq.c $(htslib_hts_h) $(htslib_vcf_h) $(htslib_synced_bcf_reader_h) $(hts
 check-no-plugins test-no-plugins: $(PROGRAMS) $(TEST_PROGRAMS) $(BGZIP) $(TABIX)
 	./test/test-rbuf
 	./test/test-regidx
+	./test/test-mwu
 	REF_PATH=: ./test/test.pl --exec bgzip=$(BGZIP) --exec tabix=$(TABIX) --htsdir=$(HTSDIR) $${TEST_OPTS:-}
 
 check-plugins test-plugins: $(PROGRAMS) $(TEST_PROGRAMS) $(BGZIP) $(TABIX) plugins
 	./test/test-rbuf
 	./test/test-regidx
+	./test/test-mwu
 	REF_PATH=: ./test/test.pl --plugins --exec bgzip=$(BGZIP) --exec tabix=$(TABIX) --htsdir=$(HTSDIR) $${TEST_OPTS:-}
 
 # test HTSlib as well, where it is built alongside BCFtools
@@ -346,6 +348,11 @@ test/test-regidx.o: test/test-regidx.c $(htslib_kstring_h) $(htslib_hts_os_h) $(
 test/test-regidx: test/test-regidx.o regidx.o | $(HTSLIB)
 	$(CC) $(ALL_LDFLAGS) -o $@ $^ $(HTSLIB_LIB) -lpthread $(ALL_LIBS)
 
+test/test-mwu.o: test/test-mwu.c
+
+test/test-mwu: test/test-mwu.o bam2bcf.o bam2bcf_indel.o bam2bcf_iaux.o read_consensus.o str_finder.o | $(HTSLIB)
+	$(CC) $(ALL_LDFLAGS) -o $@ $^ $(HTSLIB_LIB) -lpthread $(ALL_LIBS) -lm
+
 
 # make docs target depends the a2x asciidoc program
 doc/bcftools.1: doc/bcftools.txt
diff --git a/NEWS b/NEWS
index 4d4a7ad7..f72f4e97 100644
--- a/NEWS
+++ b/NEWS
@@ -31,6 +31,16 @@ Changes affecting specific commands:
 
     - Make `--nrecords` with non-standard file extensions (#2588)
 
+* bcftools mpileup
+
+    - Fix the Mann-Whitney bias annotations INFO/MQBZ, BQBZ, RPBZ, SCBZ, MQSBZ
+      and NMBZ, which were computed with 32-bit accumulators. The tie
+      correction is cubic in the number of reads sharing a quality or position
+      bin, so it overflowed once any bin held 1291 reads or more - reachable at
+      a single site when several samples are piled up together, or at high
+      depth - and the reported |Z| was then too small, hiding a real bias
+      (#NNNN)
+
 * bcftools reheader
 
     - Better error reporting on invalid --samples file, don't segfault (#2538)
diff --git a/bam2bcf.c b/bam2bcf.c
index ecc6fd63..0f2cb7fb 100644
--- a/bam2bcf.c
+++ b/bam2bcf.c
@@ -825,16 +825,20 @@ double calc_mwu_biasZ(int *a, int *b, int n, int left_only, int do_Z) {
     int b_empty = (i == n);
 
     // Count equal (e), less-than (l) and greater-than (g) permutations.
-    int e = 0, l = 0, na = 0, nb = 0;
+    // These are all quadratic or cubic in the number of reads at this site, so
+    // they must be accumulated in 64 bits: a single bin of p reads contributes
+    // p^3-p to the tie adjustment, which leaves the range of int at p = 1291.
+    int64_t e = 0, l = 0, na = 0, nb = 0;
     if (b_empty) {
         for (t = 0, i = n-1; i >= 0; i--) {
-            na += a[i];
-            t += (a[i]*a[i]-1)*a[i];  // adjustment score for ties
+            int64_t p = a[i];
+            na += p;
+            t += (p*p-1)*p;  // adjustment score for ties
         }
     } else {
         for (t = 0, i = n-1; i >= 0; i--) {
             // Combinations of a[i] and b[j] for i==j
-            e += a[i]*b[i];
+            e += (int64_t)a[i]*b[i];
 
             // nb is running total of b[i+1]..b[n-1].
             // Therefore a[i]*nb is the number of combinations of a[i] and b[j]
@@ -843,7 +847,7 @@ double calc_mwu_biasZ(int *a, int *b, int n, int left_only, int do_Z) {
 
             na += a[i];
             nb += b[i];
-            int p = a[i]+b[i];
+            int64_t p = a[i]+b[i];
             t += (p*p-1)*p;  // adjustment score for ties
         }
     }
diff --git a/test/test-mwu.c b/test/test-mwu.c
new file mode 100644
index 00000000..cf78354d
--- /dev/null
+++ b/test/test-mwu.c
@@ -0,0 +1,85 @@
+/*  test/test-mwu.c -- calc_mwu_biasZ() test harness.
+
+    Copyright (C) 2026 Genome Research Ltd.
+
+Permission is hereby granted, free of charge, to any person obtaining a copy
+of this software and associated documentation files (the "Software"), to deal
+in the Software without restriction, including without limitation the rights
+to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
+copies of the Software, and to permit persons to whom the Software is
+furnished to do so, subject to the following conditions:
+
+The above copyright notice and this permission notice shall be included in
+all copies or substantial portions of the Software.
+
+THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL
+THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+DEALINGS IN THE SOFTWARE.  */
+
+/*
+    The tie-corrected Mann-Whitney Z score behind INFO/MQBZ, BQBZ, RPBZ, SCBZ,
+    MQSBZ and NMBZ.  The histograms below are the shape bam2bcf.c builds for
+    MQBZ: reference reads and most alt reads in the top mapping-quality bin
+    (bin 59, where bam2bcf.c caps MQ), the rest of the alt reads at MQ 30.
+
+    The expected values are the same normal approximation with tie correction
+    evaluated in exact arithmetic.  The p = 1291 case is the first bin size
+    whose tie term p^3-p leaves the range of a 32-bit int.
+*/
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+#define NBINS 60
+
+double calc_mwu_biasZ(int *a, int *b, int n, int left_only, int do_Z);
+
+static int nfail = 0;
+
+static void check(const char *name, int ref_hi, int alt_hi, int alt_lo,
+                  double expect)
+{
+    int a[NBINS], b[NBINS];
+    memset(a, 0, sizeof(a));
+    memset(b, 0, sizeof(b));
+    a[59] = ref_hi;
+    b[59] = alt_hi;
+    b[29] = alt_lo;
+
+    double got = calc_mwu_biasZ(a, b, NBINS, 0, 1);
+    double tol = 1e-4 * fabs(expect);
+    if (!(fabs(got - expect) <= tol)) {
+        fprintf(stderr, "test-mwu: %s: expected %.6f, got %.6f\n",
+                name, expect, got);
+        nfail++;
+    }
+}
+
+int main(void)
+{
+    /* Largest bin fits in an int: 1290^3 = 2146689000 < INT32_MAX. */
+    check("p=1290 (tie term fits in int)", 1289, 1, 40, -35.99416982);
+
+    /* One more read in that bin and p^3 leaves the range of an int. */
+    check("p=1291 (tie term exceeds int)", 1290, 1, 40, -36.00771992);
+
+    /* A 30-sample pileup at 100x: the bin holds 2950 reads. */
+    check("30 samples x 100x", 2850, 100, 50, -31.07699569);
+
+    /* Small pileup, well inside the range: guards against a regression in the
+       ordinary case. */
+    check("220 reads", 200, 10, 10, -10.21203771);
+
+    if (nfail) {
+        fprintf(stderr, "test-mwu: %d test(s) failed\n", nfail);
+        return 1;
+    }
+    printf("test-mwu: all tests passed\n");
+    return 0;
+}
