index 9d05227..01dbb22 100644
--- a/test/test_parsers.py
+++ b/test/test_parsers.py
@@ -124,6 +124,35 @@ def test_bam_reader(data_folder):
     print("Test passed")
 
 
+def test_bam_reader_getitem_window(tmp_path):
+    """BAM_Reader[iv] must return every alignment overlapping the 0-based,
+    half-open interval iv, including one whose last aligned base is iv.start."""
+    import pysam
+
+    fn = str(tmp_path / "window.bam")
+    header = {"HD": {"VN": "1.6", "SO": "coordinate"}, "SQ": [{"SN": "chr1", "LN": 1000}]}
+    with pysam.AlignmentFile(fn, "wb", header=header) as f:
+        for name, start in (("ends_at_99", 90), ("covers_base_100", 91), ("inside", 95), ("last_base", 199),
+                            ("starts_at_200", 200)):
+            a = pysam.AlignedSegment()
+            a.query_name = name
+            a.query_sequence = "A" * 10
+            a.flag = 0
+            a.reference_id = 0
+            a.reference_start = start
+            a.mapping_quality = 60
+            a.cigartuples = [(0, 10)]
+            a.query_qualities = pysam.qualitystring_to_array("I" * 10)
+            f.write(a)
+    pysam.index(fn)
+
+    iv = HTSeq.GenomicInterval("chr1", 100, 200, ".")
+    names = [almnt.read.name for almnt in HTSeq.BAM_Reader(fn)[iv]]
+    assert names == ["covers_base_100", "inside", "last_base"]
+    for almnt in HTSeq.BAM_Reader(fn):
+        assert almnt.iv.overlaps(iv) == (almnt.read.name in names)
+
+
 def test_bam_inconsistent_mate(data_folder):
     print("Test inconsistent BAM file")
     bamfile = HTSeq.BAM_Reader(data_folder + "inconsistent_mate.bam")
