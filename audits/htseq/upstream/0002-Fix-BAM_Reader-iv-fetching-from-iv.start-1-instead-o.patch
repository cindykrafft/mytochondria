From 32035b68e66b07cd0203d360341d5cc7fa582ef8 Mon Sep 17 00:00:00 2001
From: Cindy Krafft <cynthiacondra@gmail.com>
Date: Thu, 3 Sep 2026 03:56:23 +0000
Subject: [PATCH] Fix BAM_Reader[iv] fetching from iv.start + 1 instead of
 iv.start

BAM_Reader.__getitem__ called pysam.AlignmentFile.fetch(iv.chrom,
iv.start + 1, iv.end). pysam's fetch takes 0-based, half-open coordinates,
the same convention as GenomicInterval, so the window was shifted right by
one base and an alignment whose last aligned base is iv.start was not
returned although iv.overlaps(alignment.iv) is True. Use iv.start. Adds a
test with a small BAM written by pysam and a history entry.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TaHntBDKuZJpMAAMenkC44
---
 HTSeq/__init__.py    |  3 ++-
 doc/history.rst      |  8 ++++++++
 test/test_parsers.py | 29 +++++++++++++++++++++++++++++
 3 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/HTSeq/__init__.py b/HTSeq/__init__.py
index c409d99..296d691 100644
--- a/HTSeq/__init__.py
+++ b/HTSeq/__init__.py
@@ -1062,7 +1062,8 @@ class BAM_Reader:
             not self.sf.has_index()
         ):
             raise ValueError("The .bam-file has no index, random-access is disabled!")
-        for pa in self.sf.fetch(iv.chrom, iv.start + 1, iv.end):
+        # pysam.fetch takes 0-based, half-open coordinates like GenomicInterval
+        for pa in self.sf.fetch(iv.chrom, iv.start, iv.end):
             yield SAM_Alignment.from_pysam_AlignedRead(pa, self.sf)
 
     def get_header_dict(self):
diff --git a/doc/history.rst b/doc/history.rst
index 6208884..c32dabc 100644
--- a/doc/history.rst
+++ b/doc/history.rst
@@ -4,6 +4,14 @@
 Version history
