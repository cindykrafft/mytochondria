@@ -98,6 +98,18 @@ run_timed ${IQTREE_BIN} -s ${WD}/codon.fa -st CODON -te ${WD}/codon.tree -blfix
 
 run_timed ${IQTREE_BIN} -s ${WD}/codon.fa -st CODON -te ${WD}/codon.tree -blfix -m "GY{0.8,1.07}+F3X4" --prefix ${OUT_DIR}/codon.gy.f3x4 -T 1 -seed $SEED
 
+# SH-aLRT replicates are bootstrap samples whichever of -B / -J the tree search uses (issue #198)
+
+run_timed ${IQTREE_BIN} -s ${WD}/turtle.fa -B 1000 -alrt 1000 --prefix ${OUT_DIR}/turtle.alrt.boot -T 1 -seed $SEED
+
+run_timed ${IQTREE_BIN} -s ${WD}/turtle.fa -J 1000 -alrt 1000 --prefix ${OUT_DIR}/turtle.alrt.jack -T 1 -seed $SEED
+
+# same tree and seed: the SH-aLRT values (first number of each "SH-aLRT/UF" label) must be identical
+if [ "$(grep -o ')[0-9.]*/' ${OUT_DIR}/turtle.alrt.boot.treefile)" != "$(grep -o ')[0-9.]*/' ${OUT_DIR}/turtle.alrt.jack.treefile)" ]; then
+    echo "FAIL: SH-aLRT values differ between the -B and the -J run (issue #198)"
+    exit 1
+fi
+
 
 ## amino acid test cases
 echo "Running amino acid test cases..."
