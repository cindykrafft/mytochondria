diff --git a/test_scripts/test_iqtree.ps1 b/test_scripts/test_iqtree.ps1
index d48ddde8..be74585b 100755
--- a/test_scripts/test_iqtree.ps1
+++ b/test_scripts/test_iqtree.ps1
@@ -105,6 +105,17 @@ $CodonFreq = (Get-Content $WD/codon_freq.txt -Raw).Trim()
 Measure-IQTree "$IQTreeBin -s $WD/codon.fa -st CODON -te $WD/codon.tree -blfix -m `"GY{0.8,1.07}+FU{$CodonFreq}`" --prefix $OutDir/codon.gy.fu -T 1 -seed $SEED"
 Measure-IQTree "$IQTreeBin -s $WD/codon.fa -st CODON -te $WD/codon.tree -blfix -m `"GY{0.8,1.07}+F3X4`" --prefix $OutDir/codon.gy.f3x4 -T 1 -seed $SEED"
 
+# SH-aLRT replicates are bootstrap samples whichever of -B / -J the tree search uses (issue #198)
+Measure-IQTree "$IQTreeBin -s $WD/turtle.fa -B 1000 -alrt 1000 --prefix $OutDir/turtle.alrt.boot -T 1 -seed $SEED"
+Measure-IQTree "$IQTreeBin -s $WD/turtle.fa -J 1000 -alrt 1000 --prefix $OutDir/turtle.alrt.jack -T 1 -seed $SEED"
+# same tree and seed: the SH-aLRT values (first number of each "SH-aLRT/UF" label) must be identical
+$AlrtBoot = [regex]::Matches((Get-Content $OutDir/turtle.alrt.boot.treefile -Raw), '\)[0-9.]*/') | ForEach-Object { $_.Value }
+$AlrtJack = [regex]::Matches((Get-Content $OutDir/turtle.alrt.jack.treefile -Raw), '\)[0-9.]*/') | ForEach-Object { $_.Value }
+if (($AlrtBoot -join ' ') -ne ($AlrtJack -join ' ')) {
+    Write-Host "FAIL: SH-aLRT values differ between the -B and the -J run (issue #198)"
+    exit 1
+}
