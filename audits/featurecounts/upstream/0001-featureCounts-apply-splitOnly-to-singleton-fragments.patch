From 3ad59a3ed535c11ff7d6ca8331ae31e4752dcfed Mon Sep 17 00:00:00 2001
From: Mytochondria <cynthiacondra@gmail.com>
Date: Tue, 8 Sep 2026 15:19:28 +0000
Subject: [PATCH] featureCounts: apply --splitOnly to singleton fragments in
 read-pair mode

With `-p --countReadPairs --splitOnly`, a fragment was excluded only after
two mapped non-split records had been seen. A fragment whose mate is
unmapped, or a single-end record in a paired-end file (which gets an
unmapped placeholder mate), never reached that count and was counted as
if it were split. The manual: "only split alignments (CIGAR strings
contain letter 'N') will be counted. All the other alignments will be
ignored."

Count an unmapped record as a non-split record in read-pair mode, so a
fragment is excluded when none of its mapped records is split. The
bookkeeping for Unassigned_NonSplit/Unassigned_Split moves into a helper.

Adds test/featureCounts/data/corner-SPLITONLY.{sam,ora}: three non-split
singleton fragments, two single-end non-split records, two non-split
pairs, two split pairs and one split singleton; expected simu_gene1 = 3.
Unmodified code gives 8.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TaHntBDKuZJpMAAMenkC44
---
 src/readSummary.c                            | 49 ++++++++++++--------
 test/featureCounts/data/corner-SPLITONLY.ora |  9 ++++
 test/featureCounts/data/corner-SPLITONLY.sam | 22 +++++++++
 test/featureCounts/test_corner_cases.sh      |  1 +
 4 files changed, 61 insertions(+), 20 deletions(-)

diff --git a/src/readSummary.c b/src/readSummary.c
index ebc0f1b..f83cd3a 100644
--- a/src/readSummary.c
+++ b/src/readSummary.c
@@ -2921,6 +2921,20 @@ void warning_anno_BAM_chromosomes(fc_thread_global_context_t * global_context){
 
 void add_scRNA_read_to_pool( fc_thread_global_context_t * global_context,  fc_thread_thread_context_t * thread_context, srInt_64 assign_target_number, char * read_name, char * read_bin, ArrayList * target_list );
 
+// Record a read or fragment that is excluded by --splitOnly or --nonSplitOnly.
+void mark_unassigned_junction_condition(fc_thread_global_context_t * global_context, fc_thread_thread_context_t * thread_context, char * RG_ptr, char * read_name, char * bin1, char * bin2){
+	if(global_context -> read_details_out_FP)
+		write_read_details_FP(global_context, thread_context, (global_context->is_split_or_exonic_only == 2)?"Unassigned_Split":"Unassigned_NonSplit", -1, NULL, bin1, bin2);
+
+	if(RG_ptr){
+		void ** tab4s = get_RG_tables(global_context, thread_context, RG_ptr);
+		fc_read_counters * sumtab = tab4s[1];
+		sumtab -> unassigned_junction_condition++;
+	}else thread_context->read_counters.unassigned_junction_condition ++;
+
+	if(global_context -> do_scRNA_table) add_scRNA_read_to_pool(global_context, thread_context, -1, read_name, bin1, NULL);
+}
+
 void process_line_buffer(fc_thread_global_context_t * global_context, fc_thread_thread_context_t * thread_context, char * bin1, char * bin2)
 {
 	if(global_context -> is_input_bad_format) return;
@@ -3131,7 +3145,19 @@ void process_line_buffer(fc_thread_global_context_t * global_context, fc_thread_
 
 		}
 
-		if(SAM_FLAG_UNMAPPED & alignment_masks) continue;
+		if(SAM_FLAG_UNMAPPED & alignment_masks){
+			// --splitOnly: an unmapped mate (or the placeholder mate of a single-end read in
+			// paired-end mode) is a non-split record as well. Without counting it here, a
+			// fragment whose only mapped read is non-split was counted as if it were split.
+			if(global_context->is_split_or_exonic_only == 1 && global_context -> is_paired_end_mode_assign){
+				skipped_for_exonic ++;
+				if(skipped_for_exonic == 2){
+					mark_unassigned_junction_condition(global_context, thread_context, RG_ptr, read_name, bin1, bin2);
+					return;
+				}
+			}
+			continue;
+		}
 
 		if( NH_value > 1 ) {
 			if(global_context -> is_multi_mapping_allowed == 0) {
@@ -3191,31 +3217,14 @@ void process_line_buffer(fc_thread_global_context_t * global_context, fc_thread_
 			skipped_for_exonic ++;
 
 			if(skipped_for_exonic == 1 + global_context -> is_paired_end_mode_assign){
-				if(global_context -> read_details_out_FP)
-					write_read_details_FP(global_context, thread_context, (global_context->is_split_or_exonic_only == 2)?"Unassigned_Split":"Unassigned_NonSplit", -1, NULL, bin1, bin2);
-
-				if(RG_ptr){
-					void ** tab4s = get_RG_tables(global_context, thread_context, RG_ptr);
-					fc_read_counters * sumtab = tab4s[1];
-					sumtab -> unassigned_junction_condition++;
-				}else thread_context->read_counters.unassigned_junction_condition ++;
-
-				if(global_context -> do_scRNA_table) add_scRNA_read_to_pool(global_context, thread_context, -1, read_name, bin1, NULL);
+				mark_unassigned_junction_condition(global_context, thread_context, RG_ptr, read_name, bin1, bin2);
 				return;
 			}
 		}
 
 
 		if(global_context->is_split_or_exonic_only == 2 && is_junction_read) {
-			if(global_context -> read_details_out_FP)
-				write_read_details_FP(global_context, thread_context,(global_context->is_split_or_exonic_only == 2)?"Unassigned_Split":"Unassigned_NonSplit", -1, NULL, bin1, bin2);
-			if(RG_ptr){
-				void ** tab4s = get_RG_tables(global_context, thread_context, RG_ptr);
-				fc_read_counters * sumtab = tab4s[1];
-				sumtab -> unassigned_junction_condition++;
-			}else thread_context->read_counters.unassigned_junction_condition ++;
-
-			if(global_context -> do_scRNA_table) add_scRNA_read_to_pool(global_context, thread_context, -1, read_name, bin1, NULL);
+			mark_unassigned_junction_condition(global_context, thread_context, RG_ptr, read_name, bin1, bin2);
 			return;
 		}
 
